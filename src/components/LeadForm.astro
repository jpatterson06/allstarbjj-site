---
// Hero opt-in form — wired to /api/lead-capture Netlify function.
// Saves lead to Supabase and fires the AI follow-up SMS funnel.
export interface Props {
  programLocked?: string; // pre-fill program when used on a service page
  sourceTown?: string;    // town slug for attribution (e.g. "union", "springfield")
}
const { programLocked, sourceTown } = Astro.props;

const programDisplay: Record<string, string> = {
  'Adult BJJ':        'Brazilian Jiu Jitsu',
  'Adult Muay Thai':  'Muay Thai',
  'Adult MMA':        'MMA',
  'Self Defense':     'Self Defense',
  'Lions':            'Kids — Lions',
  'Cubs':             'Preschool — Cubs',
};
const headerLabel = programLocked ? programDisplay[programLocked] ?? programLocked : null;
---

<form
  id="lead-form"
  class="bg-brand-red text-white rounded-md shadow-2xl p-6 md:p-7 w-full max-w-sm"
  novalidate
>
  <!-- Honeypot -->
  <p class="hidden" aria-hidden="true">
    <label>Don't fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
  </p>

  <!-- Hidden fields for attribution -->
  {programLocked && <input type="hidden" name="program_of_interest" value={programLocked} />}
  {sourceTown    && <input type="hidden" name="source_town"         value={sourceTown} />}

  <div class="text-center mb-5">
    {headerLabel ? (
      <>
        <div class="font-display text-2xl md:text-3xl uppercase font-black leading-tight">{headerLabel}</div>
        <div class="font-display text-lg md:text-xl uppercase font-black leading-tight mt-1">Try Free 2-Week Trial</div>
      </>
    ) : (
      <>
        <div class="font-display text-xl md:text-2xl uppercase font-black leading-tight">View Our Schedule</div>
        <div class="font-display text-xl md:text-2xl uppercase font-black leading-tight">And Gain Access To Our</div>
        <div class="font-display text-xl md:text-2xl uppercase font-black leading-tight">Exclusive Web Special</div>
      </>
    )}
  </div>

  <div class="space-y-3">
    <input
      type="text" name="first_name" required placeholder="First Name" autocomplete="given-name"
      class="w-full px-4 py-3 bg-white text-brand-black rounded-md text-sm placeholder:text-brand-gray focus:outline-none focus:ring-2 focus:ring-brand-gold"
    />
    <input
      type="text" name="last_name" required placeholder="Last Name" autocomplete="family-name"
      class="w-full px-4 py-3 bg-white text-brand-black rounded-md text-sm placeholder:text-brand-gray focus:outline-none focus:ring-2 focus:ring-brand-gold"
    />
    <input
      type="email" name="email" required placeholder="Email Address" autocomplete="email"
      class="w-full px-4 py-3 bg-white text-brand-black rounded-md text-sm placeholder:text-brand-gray focus:outline-none focus:ring-2 focus:ring-brand-gold"
    />
    <input
      type="tel" name="phone" required placeholder="Mobile Phone" autocomplete="tel"
      class="w-full px-4 py-3 bg-white text-brand-black rounded-md text-sm placeholder:text-brand-gray focus:outline-none focus:ring-2 focus:ring-brand-gold"
    />
    {!programLocked && (
      <select
        name="program_of_interest" required
        class="w-full px-4 py-3 bg-white text-brand-black rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-brand-gold"
      >
        <option value="">▼ Select A Program</option>
        <option value="Adult BJJ">Brazilian Jiu Jitsu</option>
        <option value="Adult Muay Thai">Muay Thai</option>
        <option value="Adult MMA">MMA</option>
        <option value="Self Defense">Self Defense</option>
        <option value="Lions">Kids — Lions (ages 7-13)</option>
        <option value="Cubs">Preschool — Cubs (ages 4-6)</option>
        <option value="Not sure yet">Not sure yet — help me pick</option>
      </select>
    )}
  </div>

  <!-- A2P 10DLC SMS consent — required by Twilio/carriers -->
  <label class="flex items-start gap-2 mt-4 text-[12px] text-white leading-snug cursor-pointer">
    <input
      type="checkbox" name="sms_consent" value="yes" required
      class="mt-0.5 w-4 h-4 flex-none cursor-pointer accent-brand-gold"
    />
    <span>
      I agree to receive recurring automated and personalized text messages
      from <strong>All Star Martial Arts</strong> at the number provided about my
      free trial, class schedules, appointment reminders, and customer service.
      Message frequency varies. <strong>Msg &amp; data rates may apply.</strong>
      Reply <strong>STOP</strong> to opt out, <strong>HELP</strong> for help.
      Consent is not required to purchase. View our
      <a href="/privacy-policy/" class="underline">Privacy Policy</a> &amp;
      <a href="/terms-of-service/" class="underline">Terms of Service</a>.
    </span>
  </label>

  <!-- Error message -->
  <div id="form-error" class="hidden mt-3 text-sm font-bold text-yellow-300 text-center"></div>

  <button
    type="submit"
    id="form-submit-btn"
    class="w-full mt-4 bg-brand-black hover:bg-brand-navy text-white font-bold uppercase tracking-wider text-base py-4 rounded-md transition-colors flex items-center justify-center gap-2"
  >
    <span class="bg-white text-brand-black rounded-full w-6 h-6 inline-flex items-center justify-center text-xs">→</span>
    <span id="btn-label">Get Started Today</span>
  </button>
</form>

<script>
(function () {
  const form    = document.getElementById('lead-form');
  const btn     = document.getElementById('form-submit-btn');
  const btnLbl  = document.getElementById('btn-label');
  const errBox  = document.getElementById('form-error');

  if (!form) return;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Bot check
    const bot = form.querySelector('input[name="bot-field"]');
    if (bot && bot.value) return;

    // Basic client-side validation
    const required = ['first_name', 'last_name', 'email', 'phone'];
    for (const name of required) {
      const el = form.querySelector(`[name="${name}"]`);
      if (!el || !el.value.trim()) {
        showError('Please fill in all required fields.');
        el?.focus();
        return;
      }
    }
    const consent = form.querySelector('input[name="sms_consent"]');
    if (!consent || !consent.checked) {
      showError('Please check the SMS consent box to continue.');
      return;
    }

    // Collect all form fields
    const data = {};
    for (const el of form.elements) {
      if (el.name && el.name !== 'bot-field') {
        if (el.type === 'checkbox') {
          data[el.name] = el.checked ? el.value : '';
        } else {
          data[el.name] = el.value;
        }
      }
    }

    // Append UTM params from URL
    const params = new URLSearchParams(window.location.search);
    ['utm_source','utm_medium','utm_campaign','utm_content','utm_term'].forEach(k => {
      if (params.get(k)) data[k] = params.get(k);
    });

    // Submit
    btn.disabled = true;
    clearError();
    btnLbl.textContent = 'Sending…';

    try {
      const resp = await fetch('/api/lead-capture', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify(data),
      });
      const result = await resp.json();

      if (!resp.ok || result.error) {
        throw new Error(result.error || `Server error (${resp.status})`);
      }

      // Success — redirect to schedule page with program pre-selected
      const prog = data.program_of_interest || '';
      window.location.href = prog ? '/schedule/?program=' + encodeURIComponent(prog) : '/schedule/';

    } catch (err) {
      console.error('Lead capture error:', err);
      showError('Something went wrong. Please try again or call us directly.');
      btn.disabled = false;
      btnLbl.textContent = 'Get Started Today';
    }
  });

  function showError(msg) {
    errBox.textContent = msg;
    errBox.classList.remove('hidden');
  }
  function clearError() {
    errBox.textContent = '';
    errBox.classList.add('hidden');
  }
})();
</script>
