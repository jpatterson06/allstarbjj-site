---
// Floating "Chat with AllStar" widget. Talks to /api/chat (netlify/functions/chat.mjs).
// Renders NOTHING unless PUBLIC_CHAT_ENABLED === 'true' (Netlify env var).
const enabled = import.meta.env.PUBLIC_CHAT_ENABLED === 'true';
// Optional Cloudflare Turnstile (bot check). Only active when the site key is set at build time.
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
---
{enabled && (
  <div id="as-chat" data-as-chat data-turnstile-key={turnstileKey} hidden>
    <button type="button" id="as-chat-btn" class="as-chat-btn" aria-haspopup="dialog" aria-expanded="false" aria-controls="as-chat-panel">
      Chat with AllStar
    </button>
    <div id="as-chat-panel" class="as-chat-panel" role="dialog" aria-label="Chat with AllStar" aria-modal="false" hidden>
      <div class="as-chat-head">
        <strong>AllStar Martial Arts</strong>
        <button type="button" id="as-chat-close" class="as-chat-x" aria-label="Close chat">&times;</button>
      </div>
      <div id="as-chat-log" class="as-chat-log" role="log" aria-live="polite"></div>
      <form id="as-chat-lead" class="as-chat-lead" hidden novalidate>
        <div class="as-chat-lead-head">
          <p class="as-chat-lead-title">Book your free 2-week trial</p>
          <button type="button" id="as-chat-lead-hide" class="as-chat-lead-hide">Hide</button>
        </div>
        <input type="text" name="first_name" placeholder="First name" autocomplete="given-name" required />
        <input type="text" name="last_name" placeholder="Last name" autocomplete="family-name" required />
        <input type="email" name="email" placeholder="Email" autocomplete="email" required />
        <input type="tel" name="phone" placeholder="Mobile phone" autocomplete="tel" required />
        <select name="program_of_interest" aria-label="Program">
          <option value="Not sure yet">Not sure yet - help me pick</option>
          <option value="Adult BJJ">Brazilian Jiu Jitsu</option>
          <option value="Adult Muay Thai">Muay Thai</option>
          <option value="Adult MMA">MMA</option>
          <option value="Self Defense">Self Defense</option>
          <option value="Lions">Kids - Lions (ages 7-13)</option>
          <option value="Cubs">Preschool - Cubs (ages 4-6)</option>
        </select>
        <p class="hp" aria-hidden="true"><input type="text" name="bot-field" tabindex="-1" autocomplete="off" aria-hidden="true" /></p>
        {turnstileKey && <div id="as-chat-ts" class="as-chat-ts"></div>}
        <label class="as-chat-consent">
          <input type="checkbox" name="sms_consent" value="yes" />
          <span>
            I agree to receive recurring automated and personalized text messages
            from <strong>All Star Martial Arts</strong> at the number provided about my
            free trial, class schedules, appointment reminders, and customer service.
            Message frequency varies. <strong>Msg &amp; data rates may apply.</strong>
            Reply <strong>STOP</strong> to opt out, <strong>HELP</strong> for help.
            Consent is not required to purchase. View our
            <a href="/privacy-policy/">Privacy Policy</a> &amp;
            <a href="/terms-of-service/">Terms of Service</a>.
          </span>
        </label>
        <div id="as-chat-lead-err" class="as-chat-err" role="alert" hidden></div>
        <button type="submit" class="as-chat-send" id="as-chat-lead-btn">Book my free trial</button>
      </form>
      <form id="as-chat-form" class="as-chat-form" autocomplete="off">
        <label for="as-chat-input" class="sr-only">Your message</label>
        <input id="as-chat-input" type="text" maxlength="1000" placeholder="Ask about classes, kids, the free trial..." />
        <button type="submit" class="as-chat-send" id="as-chat-send">Send</button>
      </form>
      <a class="as-chat-call" href="tel:+19083411131">Call (908) 341-1131</a>
    </div>
  </div>
)}

{enabled && (
<style is:global>
  #as-chat{position:fixed;right:16px;bottom:16px;z-index:9999;font-family:Roboto,Arial,sans-serif;font-size:15px;color:#1B1D1B}
  #as-chat .sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
  #as-chat .hp{position:absolute;left:-9999px}
  .as-chat-btn{background:#002D4D;color:#fff;border:0;border-radius:999px;padding:12px 18px;font-weight:700;cursor:pointer;box-shadow:0 4px 14px rgba(0,0,0,.3)}
  .as-chat-btn:hover{background:#0B4269}
  .as-chat-btn:focus-visible,.as-chat-send:focus-visible,.as-chat-x:focus-visible,#as-chat input:focus-visible,#as-chat select:focus-visible,.as-chat-call:focus-visible{outline:3px solid #fbbf24;outline-offset:2px}
  .as-chat-panel{position:absolute;right:0;bottom:56px;width:360px;max-width:calc(100vw - 32px);height:600px;max-height:calc(100vh - 100px);background:#fff;border-radius:12px;box-shadow:0 8px 30px rgba(0,0,0,.35);display:flex;flex-direction:column;overflow:hidden}
  .as-chat-panel[hidden]{display:none}
  .as-chat-head{background:#002D4D;color:#fff;padding:12px 14px;display:flex;justify-content:space-between;align-items:center}
  .as-chat-x{background:none;border:0;color:#fff;font-size:26px;line-height:1;cursor:pointer;padding:0 6px}
  .as-chat-log{flex:1;min-height:120px;overflow-y:auto;padding:12px;display:flex;flex-direction:column;gap:8px;background:#F8F8F8}
  .as-msg{max-width:85%;padding:8px 12px;border-radius:12px;line-height:1.35;white-space:pre-wrap;word-wrap:break-word}
  .as-msg a{color:#0B4269;text-decoration:underline;font-weight:700}
  .as-msg.me a{color:#fff}
  .as-chat-cta{display:inline-block;margin-top:8px;background:#dc2626;color:#fff !important;text-decoration:none !important;border-radius:8px;padding:10px 14px;font-weight:700}
  .as-chat-cta:focus-visible{outline:3px solid #fbbf24;outline-offset:2px}
  .as-msg.bot{background:#fff;border:1px solid #EAEAEA;align-self:flex-start}
  .as-msg.me{background:#002D4D;color:#fff;align-self:flex-end}
  .as-chat-form{display:flex;gap:6px;padding:8px;border-top:1px solid #EAEAEA}
  .as-chat-form input{flex:1;min-width:0;padding:10px;border:1px solid #ccc;border-radius:8px;font-size:16px}
  .as-chat-send{background:#dc2626;color:#fff;border:0;border-radius:8px;padding:10px 14px;font-weight:700;cursor:pointer}
  .as-chat-send:disabled{opacity:.6;cursor:default}
  .as-chat-call{display:block;text-align:center;padding:8px;font-weight:700;color:#002D4D;background:#F8F8F8;border-top:1px solid #EAEAEA;text-decoration:underline}
  .as-chat-lead{padding:10px 12px;border-top:1px solid #EAEAEA;overflow-y:auto;max-height:46%;flex-shrink:0;background:#fff;display:flex;flex-direction:column;gap:6px}
  .as-chat-lead[hidden]{display:none}
  .as-chat-lead-collapsed > *:not(.as-chat-lead-head){display:none}
  .as-chat-lead-collapsed{max-height:none;overflow:visible}
  .as-chat-lead input[type=text],.as-chat-lead input[type=email],.as-chat-lead input[type=tel],.as-chat-lead select{padding:9px;border:1px solid #ccc;border-radius:8px;font-size:16px;width:100%}
  .as-chat-lead-head{display:flex;justify-content:space-between;align-items:center;gap:8px}
  .as-chat-lead-title{font-weight:700;margin:0}
  .as-chat-lead-hide{background:none;border:0;color:#0B4269;font-weight:700;font-size:12px;text-decoration:underline;cursor:pointer;padding:2px 0;flex:none}
  .as-chat-consent{display:flex;gap:8px;font-size:11.5px;line-height:1.35;cursor:pointer}
  .as-chat-consent input{margin-top:2px;flex:none;width:16px;height:16px}
  .as-chat-consent a{text-decoration:underline}
  .as-chat-err{color:#b91c1c;font-weight:700;font-size:13px}
  @media (max-width:480px){
    .as-chat-panel{position:fixed;right:8px;left:8px;bottom:8px;width:auto;max-width:none;height:calc(100vh - 16px);max-height:none}
    .as-chat-lead{max-height:50%}
  }
  @media (prefers-reduced-motion:no-preference){.as-chat-panel{animation:asIn .15s ease-out}@keyframes asIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}}
</style>
)}

{enabled && (
<script is:inline>
(function () {
  var root = document.getElementById('as-chat');
  if (!root) return;
  // Keep out of the booking calendar's way
  if (/^\/(schedule|thanks)(\/|$)/.test(location.pathname)) return;
  root.hidden = false;

  var btn = document.getElementById('as-chat-btn');
  var panel = document.getElementById('as-chat-panel');
  var closeBtn = document.getElementById('as-chat-close');
  var log = document.getElementById('as-chat-log');
  var form = document.getElementById('as-chat-form');
  var input = document.getElementById('as-chat-input');
  var sendBtn = document.getElementById('as-chat-send');
  var lead = document.getElementById('as-chat-lead');
  var leadErr = document.getElementById('as-chat-lead-err');
  var leadBtn = document.getElementById('as-chat-lead-btn');
  var leadHideBtn = document.getElementById('as-chat-lead-hide');

  var turnstileKey = root.getAttribute('data-turnstile-key') || '';
  var leadShownAt = 0;    // when the lead form appeared (sent as form_ms)
  var tsWidgetId = null;
  var tsToken = '';
  var history = [];   // {role, content}
  var busy = false;
  var started = false;
  var leadDone = false;
  var MAX_TURNS = 12;

  function track(name, params) {
    try { if (typeof gtag === 'function') gtag('event', name, params || {}); } catch (e) {}
  }
  // --- schedule link: MUST match LeadForm.astro's redirect exactly ---
  // BEGIN scheduleUrl
  function scheduleUrl(prog) {
    return prog ? '/schedule/?program=' + encodeURIComponent(prog) : '/schedule/';
  }
  // END scheduleUrl
  var SCHEDULE_PROGRAMS = ['Adult BJJ', 'Adult Muay Thai', 'Adult MMA', 'Lions', 'Cubs'];
  var LINK_RE = /(\/schedule\/\?program=[A-Za-z0-9%]+|\/trial\/)/g;

  // Show text; turn ONLY known on-site links (/trial/, /schedule/?program=<real program>) into clickable links.
  function fill(d, text) {
    d.textContent = '';
    String(text).split(LINK_RE).forEach(function (part, i) {
      if (i % 2 === 0) { if (part) d.appendChild(document.createTextNode(part)); return; }
      var ok = part === '/trial/';
      if (!ok) {
        var prog = '';
        try { prog = decodeURIComponent(part.split('=')[1] || ''); } catch (e) {}
        ok = SCHEDULE_PROGRAMS.indexOf(prog) !== -1 && scheduleUrl(prog) === part;
      }
      if (!ok) { d.appendChild(document.createTextNode(part)); return; }
      var a = document.createElement('a');
      a.href = part; a.textContent = part;
      d.appendChild(a);
    });
  }
  function add(role, text) {
    var d = document.createElement('div');
    d.className = 'as-msg ' + (role === 'user' ? 'me' : 'bot');
    fill(d, text);
    log.appendChild(d);
    scrollToMessage(d);
    return d;
  }
  // Scroll so the TOP of this message is visible, rather than always jumping to the
  // absolute bottom of the log -- important once the lead form is showing and has
  // shrunk the log down to a fraction of the panel's height.
  function scrollToMessage(d) {
    log.scrollTop = Math.max(0, d.offsetTop - 8);
  }

  // If the visitor already named a program in chat, preselect it (latest mention wins).
  var PROGRAM_WORDS = [
    ['Adult Muay Thai', /muay\s*thai|thai\s*box/gi],
    ['Adult MMA', /\bmma\b|mixed martial/gi],
    ['Adult BJJ', /\bbjj\b|jiu[\s-]*jitsu|jujitsu|brazilian/gi],
    ['Self Defense', /self[\s-]*defen[sc]e/gi],
    ['Lions', /\blions?\b/gi],
    ['Cubs', /\bcubs?\b|pre-?school/gi]
  ];
  function detectProgram() {
    for (var i = history.length - 1; i >= 0; i--) {
      if (history[i].role !== 'user') continue;
      var best = '', bestAt = -1;
      PROGRAM_WORDS.forEach(function (pw) {
        pw[1].lastIndex = 0;
        var m, at = -1;
        while ((m = pw[1].exec(history[i].content))) at = m.index;
        if (at > bestAt) { bestAt = at; best = pw[0]; }
      });
      if (best) return best;
    }
    return '';
  }
  // Show the lead form and start the "how long was it open" timer.
  function showLeadForm() {
    if (lead.hidden) leadShownAt = Date.now();
    lead.hidden = false;
    lead.classList.remove('as-chat-lead-collapsed');
    if (leadHideBtn) leadHideBtn.textContent = 'Hide';
    loadTurnstile();
  }
  // Cloudflare Turnstile: loaded only when a site key was set at build time, and only once the form is shown.
  function loadTurnstile() {
    if (!turnstileKey || tsWidgetId !== null) return;
    var render = function () {
      var el = document.getElementById('as-chat-ts');
      if (!el || !window.turnstile || tsWidgetId !== null) return;
      tsWidgetId = window.turnstile.render(el, {
        sitekey: turnstileKey,
        callback: function (t) { tsToken = t; },
        'expired-callback': function () { tsToken = ''; },
        'error-callback': function () { tsToken = ''; }
      });
    };
    if (window.turnstile) return render();
    var sc = document.createElement('script');
    sc.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
    sc.async = true; sc.defer = true;
    sc.onload = render;
    document.head.appendChild(sc);
  }
  function openPanel() {
    panel.hidden = false;
    btn.setAttribute('aria-expanded', 'true');
    if (!started) {
      started = true;
      add('bot', "Hi, I'm AllStar's AI assistant. I can answer questions about classes, kids programs and our free 2-week trial. What would you like to know?");
      track('chat_open');
    }
    input.focus();
  }
  function closePanel() {
    panel.hidden = true;
    btn.setAttribute('aria-expanded', 'false');
    btn.focus();
  }
  btn.addEventListener('click', function () { panel.hidden ? openPanel() : closePanel(); });
  closeBtn.addEventListener('click', closePanel);
  if (leadHideBtn) {
    leadHideBtn.addEventListener('click', function () {
      var collapsed = lead.classList.toggle('as-chat-lead-collapsed');
      leadHideBtn.textContent = collapsed ? 'Show form' : 'Hide';
      log.scrollTop = log.scrollHeight;
    });
  }
  root.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !panel.hidden) { e.preventDefault(); closePanel(); }
  });

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var text = input.value.trim();
    if (!text || busy) return;
    if (history.length >= MAX_TURNS - 1) {
      add('bot', 'This chat has gotten long. Please call (908) 341-1131 or book your free trial and the team will take it from here.');
      return;
    }
    input.value = '';
    add('user', text);
    history.push({ role: 'user', content: text });
    track('chat_message');
    busy = true; sendBtn.disabled = true;
    var typing = add('bot', '...');
    fetch('/api/chat', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ messages: history })
    }).then(function (r) { return r.json().catch(function () { return {}; }); })
      .then(function (data) {
        var reply = data.reply || (data.error ? 'Sorry, something went wrong. Call (908) 341-1131 or book your free trial.' : 'Chat is offline. Call (908) 341-1131 or book your free trial.');
        fill(typing, reply);
        if (data.reply && !data.offline && !data.error) history.push({ role: 'assistant', content: reply });
        else history.pop();
        scrollToMessage(typing);
        if (data.showLeadForm && !leadDone) { var pre = detectProgram(); if (pre) lead.elements.program_of_interest.value = pre; showLeadForm(); lead.querySelector('input').focus(); scrollToMessage(typing); }
      })
      .catch(function () {
        typing.textContent = 'Chat is offline. Call (908) 341-1131 or book your free trial.';
        history.pop();
      })
      .then(function () { busy = false; sendBtn.disabled = false; if (lead.hidden) input.focus(); });
  });

  lead.addEventListener('submit', function (e) {
    e.preventDefault();
    leadErr.hidden = true;
    var f = lead.elements;
    var data = {
      first_name: f.first_name.value.trim(),
      last_name: f.last_name.value.trim(),
      email: f.email.value.trim(),
      phone: f.phone.value.trim(),
      program_of_interest: f.program_of_interest.value,
      sms_consent: f.sms_consent.checked ? 'yes' : '',
      'bot-field': f['bot-field'].value,
      form_ms: leadShownAt ? Date.now() - leadShownAt : 0
    };
    if (turnstileKey) data.turnstile_token = tsToken;
    if (!data.first_name || !data.last_name || !data.email || !data.phone) return showLeadErr('Please fill in all fields.');
    if (data.sms_consent !== 'yes') return showLeadErr('Please check the text-message consent box to continue.');
    if (turnstileKey && !tsToken) return showLeadErr('Please wait a moment for the security check to finish, then try again.');
    var params = new URLSearchParams(location.search);
    ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'].forEach(function (k) { if (params.get(k)) data[k] = params.get(k); });
    leadBtn.disabled = true; leadBtn.textContent = 'Sending...';
    fetch('/api/chat', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: 'lead', lead: data })
    }).then(function (r) { return r.json().catch(function () { return {}; }).then(function (j) { return { ok: r.ok, j: j }; }); })
      .then(function (res) {
        if (!res.ok || res.j.error) throw new Error('fail');
        leadDone = true;
        lead.hidden = true;
        track('chat_lead', { program: data.program_of_interest });
        // Same GA4 key event the website form fires (LeadForm.astro), guarded the same way.
        try {
          if (typeof gtag === 'function') {
            gtag('event', 'generate_lead', {
              form_name: 'chat_widget',
              program: data.program_of_interest || '(none selected)',
              lead_source: (new URLSearchParams(window.location.search)).get('utm_source') || 'website'
            });
          }
        } catch (e) {}
        var done = add('bot', "You're in, " + data.first_name + '! The team will text you to confirm your free trial. Want to lock in a time now?');
        var cta = document.createElement('a');
        cta.className = 'as-chat-cta';
        cta.href = scheduleUrl(data.program_of_interest);
        cta.textContent = 'Pick your class time';
        done.appendChild(document.createElement('br'));
        done.appendChild(cta);
        log.scrollTop = log.scrollHeight;
      })
      .catch(function () {
        showLeadErr('Something went wrong. Please try again or call (908) 341-1131.');
        leadBtn.disabled = false; leadBtn.textContent = 'Book my free trial';
        if (tsWidgetId !== null && window.turnstile) { tsToken = ''; try { window.turnstile.reset(tsWidgetId); } catch (e) {} }
      });
  });
  function showLeadErr(msg) { leadErr.textContent = msg; leadErr.hidden = false; }
})();
</script>
)}
