---
// HowTo schema markup for AI Overview optimization
// Use for process-based content like "How to teach preschool BJJ"

export interface HowToStep {
  name: string;
  text: string;
  image?: string; // optional step image URL
}

export interface Props {
  title: string;
  description?: string;
  steps: HowToStep[];
  image?: string; // main content image
  totalTime?: string; // ISO 8601 format (e.g., "PT30M")
  yield?: string; // result/outcome
}

const { 
  title, 
  description = '',
  steps, 
  image = '',
  totalTime = 'PT45M',
  yield: yieldVal = 'Complete understanding and confidence'
} = Astro.props;

const schemaSteps = steps.map((step, index) => ({
  "@type": "HowToStep",
  "position": index + 1,
  "name": step.name,
  "text": step.text,
  ...(step.image && { "image": step.image })
}));

const schema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": title,
  ...(description && { "description": description }),
  ...(image && { "image": image }),
  "totalTime": totalTime,
  "yield": yieldVal,
  "step": schemaSteps
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
