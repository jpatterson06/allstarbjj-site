---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
import FAQ from '../components/FAQ.astro';
import FAQPageSchema from '../components/FAQPageSchema.astro';
import LocalBusinessSchema from '../components/LocalBusinessSchema.astro';
import CTA from '../components/CTA.astro';

const faqs = [
  { q: "How far is AllStar from Chatham?", a: "About 20 minutes. Route 24 east to Route 22 east. 1166 West Chestnut St, Union, NJ 07083." },
  { q: "My kid has never done martial arts — is that okay?", a: "Most kids start from zero. Whether they're coming from Washington Elementary or the Middle School, the first belt is white for a reason." },
  { q: "Do adults need experience?", a: "No. Most students walk in untrained. Evening classes start at 6 PM — doable from Chatham after the Morris & Essex train ride home from the city." },
  { q: "Free trial?", a: "Two weeks, unlimited classes. No card, no contract." },
  { q: "How do I start?", a: "Fill out the form or call (908) 341-1131." },
];
---

<PageLayout
  title="Martial Arts in Chatham, NJ — BJJ, Muay Thai & Kids Classes | AllStar"
  description="Martial arts classes for Chatham, NJ families at AllStar Martial Arts in Union. BJJ, Muay Thai, MMA, and Kids programs. Renzo Gracie black belt. Free 2-week trial."
  ogImage="/images/adult-bjj-hero.jpg"
>
  <Fragment slot="head">
    <LocalBusinessSchema city="Chatham" />
    <FAQPageSchema faqs={faqs} />
  </Fragment>

  <PageHero
    eyebrow="20 Minutes from Chatham"
    headline="Martial Arts in Chatham, NJ"
    sub="Brazilian Jiu-Jitsu, Muay Thai, MMA, and kids classes — a straight 20-minute shot down Route 24 for Chatham families. Free 2-week trial, no contract."
    bgImage="/images/adult-bjj-hero.jpg"
  />

  <!-- Intro -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-3xl">
      <p class="text-lg md:text-xl text-brand-gray leading-relaxed mb-5">
        Chatham runs on word of mouth. Whether you're in the Borough near Fairmount Ave or over in the Township, a good recommendation travels faster along Main Street and the sidelines at Memorial Pool than any ad ever could. When Chatham families find real coaching, they pass it down the row. AllStar Martial Arts is about 20 minutes away in Union — Route 24 to Route 22 east — and Chatham members have been making that drive for years, because this kind of instruction isn't offered anywhere closer. Neighbors in <a href="/summit/" class="text-brand-navy font-bold hover:text-brand-gold transition-colors">Summit</a> and <a href="/new-providence/" class="text-brand-navy font-bold hover:text-brand-gold transition-colors">New Providence</a> make the same trip for the same reason.
      </p>
      <p class="text-lg md:text-xl text-brand-gray leading-relaxed">
        The man behind it is Coach Jamal Patterson — a Renzo Gracie black belt, ADCC veteran, and former pro MMA fighter who has run this gym in Union since 2011. The lineage traces straight from Helio Gracie through Renzo to Jamal, and the room reflects who he is: no ego, real technique, a family-owned gym that looks after its own.
      </p>
    </div>
  </section>

  <!-- Programs -->
  <section class="section-pad bg-brand-gray-light">
    <div class="container-page max-w-4xl">
      <div class="grid md:grid-cols-2 gap-10">
        <div>
          <div class="eyebrow">Adults</div>
          <h2 class="text-2xl md:text-3xl text-brand-black mb-4">BJJ for Chatham Adults</h2>
          <p class="text-brand-gray leading-relaxed">
            Adult BJJ, ages 16 and up, no experience required. Classes run at 6, 7, and 8 PM — timed so you can catch the Morris &amp; Essex line home, drop your bag, and still make the mat. The Renzo Gracie lineage runs direct from Helio Gracie to Coach Jamal, and Chatham adults who've rolled at other schools consistently point to how clearly technique gets explained here. Curious about the full program? See <a href="/adult-bjj/" class="text-brand-navy font-bold hover:text-brand-gold transition-colors">adult BJJ</a>.
          </p>
        </div>
        <div>
          <div class="eyebrow">Muay Thai</div>
          <h2 class="text-2xl md:text-3xl text-brand-black mb-4">Muay Thai Near Chatham</h2>
          <p class="text-brand-gray leading-relaxed">
            There's no Muay Thai gym in Chatham, and the fitness-studio kickboxing nearby tends to be all cardio and no craft. AllStar is the closest place to learn the real thing — genuine pad work, footwork, and technique built over rounds, not choreographed to a playlist. Two weeks free is enough to feel the difference in your first session.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Kids -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-3xl">
      <div class="eyebrow">Kids Martial Arts</div>
      <h2 class="text-3xl md:text-4xl text-brand-black mb-6">Kids Martial Arts for Chatham Families</h2>
      <div class="space-y-5">
        <div class="bg-brand-gray-light p-6 rounded-lg border-l-4 border-brand-gold">
          <h3 class="text-xl text-brand-black mb-2">Cubs — Ages 4–6</h3>
          <p class="text-brand-gray text-sm leading-relaxed">Thirty-minute classes built for preschoolers — focus, coordination, and confidence taught through games and structured movement rather than long lectures. Chatham parents keep telling us the same thing: their four-year-old is already asking when they can go back.</p>
        </div>
        <div class="bg-brand-gray-light p-6 rounded-lg border-l-4 border-brand-navy">
          <h3 class="text-xl text-brand-black mb-2">Lions — Ages 7–13</h3>
          <p class="text-brand-gray text-sm leading-relaxed">Real Brazilian Jiu-Jitsu with a progressive belt system and honest challenge. The Chatham kids who make the drive from Chatham High or the Middle School tend to be all-in, and it shows in how fast they climb. Bully-proofing is one of the first reasons Chatham parents call us — see how our <a href="/kids/" class="text-brand-navy font-bold hover:text-brand-gold transition-colors">kids program</a> works.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Landmarks -->
  <section class="section-pad bg-brand-navy text-white">
    <div class="container-page max-w-3xl">
      <div class="eyebrow text-brand-gold">If you know Chatham</div>
      <h2 class="text-2xl md:text-3xl mb-5">You Know These Spots — We're 20 Minutes Away</h2>
      <div class="flex flex-wrap gap-2">
        {["Downtown Chatham", "Chatham Train Station", "Lafayette Ave", "Chatham High School", "Chatham Middle School", "Washington Elementary", "Memorial Pool", "Fairmount Ave"].map((l) => (
          <span class="bg-white/10 text-white/90 px-4 py-2 rounded-full text-sm">📍 {l}</span>
        ))}
      </div>
      <p class="text-white/80 mt-5 text-sm">About 20 minutes on Route 24 to Route 22 east. Free parking at AllStar.</p>
    </div>
  </section>

  <FAQ items={faqs} />

  <CTA
    headline="Two Weeks Free — Chatham Families Welcome"
    sub="Show up. Bring water. We'll handle the rest. No commitment, no pressure."
  />
</PageLayout>
