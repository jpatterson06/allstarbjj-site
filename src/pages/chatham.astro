---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';

const faqs = [
  { q: "How far is AllStar from Chatham?", a: "About 20 minutes. Route 24 east to Route 22 east. 1166 West Chestnut St, Union, NJ 07083." },
  { q: "My kid has never done martial arts — is that okay?", a: "Most kids start from zero. The first belt is white for a reason." },
  { q: "Do adults need experience?", a: "No. Most students walk in untrained. Evening classes start at 6 PM — doable from Chatham after a NYC commute." },
  { q: "Free trial?", a: "Two weeks, unlimited classes. No card, no contract." },
  { q: "How do I start?", a: "Fill out the form or call (908) 341-1131." },
];
---

<PageLayout
  title="Martial Arts in Chatham, NJ — BJJ, Muay Thai & Kids Classes | AllStar"
  description="Martial arts classes for Chatham, NJ families at AllStar Martial Arts in Union. BJJ, Muay Thai, MMA, and Kids programs. Renzo Gracie black belt. Free 2-week trial."
  ogImage="/images/adult-bjj-hero.jpg"
>
  <PageHero
    eyebrow="20 Minutes from Chatham"
    headline="Martial Arts in Chatham, NJ"
    sub="Brazilian Jiu-Jitsu, Muay Thai, MMA, and Kids programs. Real instruction, 20 minutes away. Free 2-week trial — no contract."
    bgImage="/images/adult-bjj-hero.jpg"
  />

  <!-- Intro -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-3xl">
      <p class="text-lg md:text-xl text-brand-gray leading-relaxed mb-5">
        Chatham is a tight-knit community where word travels fast. When Chatham families find something worth the drive, they tell their neighbors. AllStar Martial Arts in Union is about 20 minutes from Chatham on Route 24 to Route 22. Chatham members have been making that drive for years — because the coaching here isn't available anywhere closer.
      </p>
      <p class="text-lg md:text-xl text-brand-gray leading-relaxed">
        Coach Jamal Patterson is a Renzo Gracie black belt, ADCC veteran, and former pro MMA fighter. He's coached in Union since 2011. The gym he runs reflects who he is: no ego, real instruction, a community that takes care of its own.
      </p>
    </div>
  </section>

  <!-- Programs -->
  <section class="section-pad bg-brand-gray-light">
    <div class="container-page max-w-4xl">
      <div class="grid md:grid-cols-2 gap-10">
        <div>
          <div class="eyebrow">Adults</div>
          <h2 class="text-2xl md:text-3xl text-brand-black mb-4">BJJ for Chatham Adults</h2>
          <p class="text-brand-gray leading-relaxed">
            Adult BJJ, ages 16 and up. No experience needed. Evening classes at 6, 7, and 8 PM — doable from Chatham after a NYC commute. The Renzo Gracie lineage is direct from Helio Gracie through Renzo to Coach Jamal. Chatham adults who've trained at other schools and come to AllStar consistently notice the difference in how technique is explained.
          </p>
        </div>
        <div>
          <div class="eyebrow">Muay Thai</div>
          <h2 class="text-2xl md:text-3xl text-brand-black mb-4">Muay Thai Near Chatham</h2>
          <p class="text-brand-gray leading-relaxed">
            Chatham has no Muay Thai gym. AllStar is the closest authentic option. Real pad work, real technique. Adults who've tried kickboxing studios in the area and found them shallow make their way to us. Two weeks free — see the difference in your first class.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Kids -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-3xl">
      <div class="eyebrow">Kids Martial Arts</div>
      <h2 class="text-3xl md:text-4xl text-brand-black mb-6">Kids Martial Arts for Chatham Families</h2>
      <div class="space-y-5">
        <div class="bg-brand-gray-light p-6 rounded-lg border-l-4 border-brand-gold">
          <h3 class="text-xl text-brand-black mb-2">Cubs — Ages 4–6</h3>
          <p class="text-brand-gray text-sm leading-relaxed">30-minute classes built for preschoolers. Focus, coordination, and confidence — through games and structured movement. Chatham parents tell us their kids beg to come back after the first class.</p>
        </div>
        <div class="bg-brand-gray-light p-6 rounded-lg border-l-4 border-brand-navy">
          <h3 class="text-xl text-brand-black mb-2">Lions — Ages 7–13</h3>
          <p class="text-brand-gray text-sm leading-relaxed">Real Brazilian Jiu-Jitsu. Progressive curriculum, belt system, real challenge. Kids who make the drive from Chatham tend to be more committed — and it shows in how quickly they progress. Bully prevention is one of the top reasons Chatham parents come to us.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Landmarks -->
  <section class="section-pad bg-brand-navy text-white">
    <div class="container-page max-w-3xl">
      <div class="eyebrow text-brand-gold">If you know Chatham</div>
      <h2 class="text-2xl md:text-3xl mb-5">You Know These Spots — We're 20 Minutes Away</h2>
      <div class="flex flex-wrap gap-2">
        {["Downtown Chatham", "Chatham Train Station", "Lafayette Ave", "Chatham High School", "Chatham Middle School", "Washington Elementary", "Memorial Pool", "Fairmount Ave"].map((l) => (
          <span class="bg-white/10 text-white/90 px-4 py-2 rounded-full text-sm">📍 {l}</span>
        ))}
      </div>
      <p class="text-white/80 mt-5 text-sm">About 20 minutes on Route 24 to Route 22 east. Free parking at AllStar.</p>
    </div>
  </section>

  <FAQ items={faqs} />

  <CTA
    headline="Two Weeks Free — Chatham Families Welcome"
    sub="Show up. Bring water. We'll handle the rest. No commitment, no pressure."
  />
</PageLayout>
