---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
import FAQ from '../components/FAQ.astro';
import FAQPageSchema from '../components/FAQPageSchema.astro';
import LocalBusinessSchema from '../components/LocalBusinessSchema.astro';
import CTA from '../components/CTA.astro';

const faqs = [
  { q: "How far is AllStar from Mountainside?", a: "About 10 minutes — a straight shot down Route 22. 1166 West Chestnut St, Union, NJ 07083." },
  { q: "Do kids need experience?", a: "No. White belt, day one — the curriculum starts from the beginning." },
  { q: "Do I need experience as an adult?", a: "No. Most students walk in with zero martial arts background. The beginner curriculum assumes zero." },
  { q: "Free trial?", a: "Two weeks unlimited. No card, no contract, no pressure." },
  { q: "How do I start?", a: "Fill out the form or call (908) 341-1131." },
];
---

<PageLayout
  title="Martial Arts in Mountainside, NJ — BJJ, Muay Thai & Kids | AllStar"
  description="Martial arts classes for Mountainside, NJ families at AllStar Martial Arts in Union. BJJ, Muay Thai, MMA, and Kids programs. Renzo Gracie black belt. Free 2-week trial."
  ogImage="/images/adult-bjj-hero.jpg"
>
  <Fragment slot="head">
    <LocalBusinessSchema city="Mountainside" />
    <FAQPageSchema faqs={faqs} />
  </Fragment>

  <PageHero
    eyebrow="10 Minutes from Mountainside"
    headline="Martial Arts in Mountainside, NJ"
    sub="Ten minutes down Route 22 to a Renzo Gracie black belt. BJJ, Muay Thai, MMA, and kids programs. Free 2-week trial — no contract."
    bgImage="/images/adult-bjj-hero.jpg"
  />

  <!-- Intro -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-3xl">
      <p class="text-lg md:text-xl text-brand-gray leading-relaxed mb-5">
        Mountainside is a small borough that carries big standards. When parents here go looking for a martial arts program — for the kids or for themselves — they aren't chasing whatever sits closest to the Watchung Reservation. They want the best one within a sensible drive, and they're happy to pass a few nearer options to get it.
      </p>
      <p class="text-lg md:text-xl text-brand-gray leading-relaxed">
        AllStar is 10 minutes away, a quick run down Route 22. Coach Jamal Patterson is a Renzo Gracie black belt, ADCC veteran, and former professional MMA fighter who has run this family-owned gym in Union since 2011. Neighbors over in <a href="/westfield/" class="text-brand-navy font-bold hover:text-brand-gold transition-colors">Westfield</a> and <a href="/scotch-plains/" class="text-brand-navy font-bold hover:text-brand-gold transition-colors">Scotch Plains →</a> make the same short trip. The drive is worth it.
      </p>
    </div>
  </section>

  <!-- Programs -->
  <section class="section-pad bg-brand-gray-light">
    <div class="container-page max-w-4xl">
      <div class="grid md:grid-cols-2 gap-10">
        <div>
          <div class="eyebrow">Adults</div>
          <h2 class="text-2xl md:text-3xl text-brand-black mb-4">BJJ for Mountainside Adults</h2>
          <p class="text-brand-gray leading-relaxed">
            Adult Brazilian Jiu-Jitsu, ages 16 and up. Beginners start from scratch — most adults arrive with zero experience and feel at home within a few weeks. Evening classes fit around the Mountainside commuter schedule, and the Renzo Gracie lineage means something concrete here: the teaching methodology traces straight back to Helio Gracie's original system. New to grappling? Our <a href="/adult-bjj/" class="text-brand-navy font-bold hover:text-brand-gold transition-colors">adult BJJ program →</a> is where to begin.
          </p>
        </div>
        <div>
          <div class="eyebrow">Muay Thai</div>
          <h2 class="text-2xl md:text-3xl text-brand-black mb-4">Muay Thai Near Mountainside</h2>
          <p class="text-brand-gray leading-relaxed">
            Mountainside has no Muay Thai gym of its own, so AllStar is the closest at 10 minutes — a real striking art with real conditioning and real technique, not a cardio class dressed up with Thai branding. Adults routinely cross-train Muay Thai and BJJ together for the most complete program in the area.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Kids -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-3xl">
      <div class="eyebrow">Kids Martial Arts</div>
      <h2 class="text-3xl md:text-4xl text-brand-black mb-6">Kids Martial Arts for Mountainside Families</h2>
      <p class="text-brand-gray leading-relaxed mb-5">
        Mountainside kids usually juggle a few activities at once. What keeps them coming back to AllStar after others fade is simple — they can feel themselves getting better. BJJ holds one of the highest retention rates of any kids activity precisely because the progress is visible, earned, and impossible to fake.
      </p>
      <div class="space-y-5">
        <div class="bg-brand-gray-light p-6 rounded-lg border-l-4 border-brand-gold">
          <h3 class="text-xl text-brand-black mb-2">Cubs — Ages 4–6</h3>
          <p class="text-brand-gray text-sm leading-relaxed">Coordination, listening, confidence — 30 minutes of structured movement and games.</p>
        </div>
        <div class="bg-brand-gray-light p-6 rounded-lg border-l-4 border-brand-navy">
          <h3 class="text-xl text-brand-black mb-2">Lions — Ages 7–13</h3>
          <p class="text-brand-gray text-sm leading-relaxed">Real BJJ with a progressive belt system. Mountainside parents consistently report that the focus carries over into school.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Landmarks -->
  <section class="section-pad bg-brand-navy text-white">
    <div class="container-page max-w-3xl">
      <div class="eyebrow text-brand-gold">If you know Mountainside</div>
      <h2 class="text-2xl md:text-3xl mb-5">You Know These Spots — We're 10 Minutes Away</h2>
      <div class="flex flex-wrap gap-2">
        {["Mountainside Borough Hall", "Mountainside School", "Echo Lake Park", "Mountainside Pool", "Springfield Ave corridor", "Watchung Reservation entrance"].map((l) => (
          <span class="bg-white/10 text-white/90 px-4 py-2 rounded-full text-sm">📍 {l}</span>
        ))}
      </div>
      <p class="text-white/80 mt-5 text-sm">10 minutes to AllStar. Free parking on-site.</p>
    </div>
  </section>

  <FAQ items={faqs} />

  <CTA
    headline="Two Weeks Free — Mountainside Families Welcome"
    sub="Show up. Bring water. We'll handle the rest. No commitment, no pressure."
  />
</PageLayout>
