---
import PageLayout from '../../layouts/PageLayout.astro';
import LeadForm from '../../components/LeadForm.astro';
import FAQ from '../../components/FAQ.astro';
import { towns } from '../../lib/towns';

const faqs = [
  { q: "What's the difference between Cubs and Lions?", a: "Cubs (ages 4–7) is our preschool/early-childhood program focused on listening, structure, coordination, and fun — the foundation for everything. Lions (ages 7–14) is real BJJ for kids — techniques, drilling, rolling, and competition prep for those who want it." },
  { q: "Does my child need any experience?", a: "None. Most kids join with zero martial arts background. Coaches are trained to work with children at every developmental level." },
  { q: "Is it safe? Will my child get hurt?", a: "Safety is our top priority. In Cubs, there is no contact sparring. In Lions, controlled rolling is introduced gradually and only when the child is ready. We have never had a serious injury in our kids programs." },
  { q: "Do I need to buy a gi or gear?", a: "Not for the trial. We provide everything your child needs for the 2 free weeks. Just send them in athletic clothes." },
  { q: "Do I need to pay anything for the trial?", a: "No. Two weeks completely free. No card on file, no contract, no pressure." },
  { q: "How does the program build confidence and discipline?", a: "Through progressive skill mastery, respect rituals (bowing, listening, addressing instructors), and the experience of challenging yourself and succeeding. Most parents see a change in behavior and focus within the first month." },
  { q: "Is there parking?", a: "Free lot on-site at 1166 West Chestnut St, Union, NJ. Easy in, easy out." },
];

const testimonials = [
  { name: "Jennifer R.", program: "Parent — Lions", quote: "My kids transformed. Better focus, confidence, discipline — and they love going to class every week." },
  { name: "Patricia M.", program: "Parent — Cubs", quote: "My 5-year-old went from shy to confident in 3 months. The Cubs instructors are incredible." },
  { name: "Tony G.", program: "Parent — Lions", quote: "My son is 12 and has been in Lions for a year. Grades improved, attitude improved — total transformation." },
];
---

<PageLayout
  title="Free 2-Week Kids Martial Arts Trial in Union, NJ — AllStar"
  description="Free 2-week kids martial arts trial at AllStar in Union, NJ. Cubs (ages 4–7) and Lions (ages 7–14). Build confidence, discipline, and focus."
  ogImage={"/images/adult-bjj-hero.jpg"}
>

  <!-- HERO + FORM -->
  <section class="bg-brand-black text-white">
    <div class="container-page py-14 md:py-20">
      <div class="flex flex-col lg:flex-row gap-12 items-center">
        <div class="flex-1 text-center lg:text-left">
          <div class="inline-block bg-brand-red text-white text-xs font-bold uppercase tracking-widest px-3 py-1 rounded mb-5">
            Limited Spots Available
          </div>
          <h1 class="font-display text-4xl md:text-5xl xl:text-6xl uppercase font-black leading-tight mb-5">
            Give Your Child
            <span class="text-brand-gold">2 Weeks FREE</span>
          </h1>
          <p class="text-gray-300 text-lg md:text-xl leading-relaxed mb-8">
            Build confidence, discipline, and focus in a safe, fun environment. Cubs (ages 4–7) and Lions (ages 7–14) — taught by coaches who genuinely care about your child.
          </p>
          <div class="flex flex-wrap gap-3 justify-center lg:justify-start mb-8">
            <span class="bg-white/10 text-white text-sm px-4 py-2 rounded-full">✅ Cubs ages 4–7</span>
            <span class="bg-white/10 text-white text-sm px-4 py-2 rounded-full">✅ Lions ages 7–14</span>
            <span class="bg-white/10 text-white text-sm px-4 py-2 rounded-full">✅ Anti-bullying focus</span>
            <span class="bg-white/10 text-white text-sm px-4 py-2 rounded-full">📍 Union, NJ</span>
          </div>
          <div class="flex gap-8 justify-center lg:justify-start text-center">
            <div>
              <div class="font-display text-3xl text-brand-gold font-black">500+</div>
              <div class="text-gray-400 text-xs uppercase tracking-wide">Students trained</div>
            </div>
            <div>
              <div class="font-display text-3xl text-brand-gold font-black">15+</div>
              <div class="text-gray-400 text-xs uppercase tracking-wide">Years in Union</div>
            </div>
            <div>
              <div class="font-display text-3xl text-brand-gold font-black">5★</div>
              <div class="text-gray-400 text-xs uppercase tracking-wide">Google rating</div>
            </div>
          </div>
        </div>
        <div class="w-full lg:w-auto lg:min-w-[340px]">
          <LeadForm />
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT'S INCLUDED STRIP -->
  <section class="bg-brand-red text-white py-5">
    <div class="container-page">
      <ul class="flex flex-wrap justify-center gap-x-10 gap-y-2 text-sm font-bold uppercase tracking-wide">
        <li>🥋 Unlimited Kids Classes for 2 Weeks</li>
        <li>🎒 All Gear Provided</li>
        <li>👨‍🏫 Intro with Coach Jamal</li>
        <li>🚫 No Card · No Contract · No Pressure</li>
      </ul>
    </div>
  </section>

  <!-- PROGRAMS BREAKDOWN -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-5xl">
      <div class="text-center mb-10">
        <div class="eyebrow">Two programs for every age</div>
        <h2 class="font-display text-3xl md:text-4xl uppercase font-black text-brand-black">
          Pick the Right Program for Your Child
        </h2>
      </div>
      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-brand-gray-light rounded-xl p-8 border-t-4 border-brand-gold">
          <div class="text-4xl mb-4">🐯</div>
          <h3 class="font-display text-2xl uppercase font-black text-brand-black mb-1">Cubs</h3>
          <div class="text-brand-red font-bold text-sm uppercase tracking-wide mb-4">Ages 4–7</div>
          <p class="text-brand-gray leading-relaxed mb-4">
            Our preschool and early-childhood program. Cubs focuses on listening, following instructions, basic coordination, and building the discipline habits that will carry your child through life.
          </p>
          <ul class="space-y-2 text-brand-black text-sm">
            <li class="flex items-start gap-2"><span>✅</span> No prior experience needed</li>
            <li class="flex items-start gap-2"><span>✅</span> No contact sparring — completely safe</li>
            <li class="flex items-start gap-2"><span>✅</span> Small class sizes, attentive coaches</li>
            <li class="flex items-start gap-2"><span>✅</span> Focus on listening, respect, and fun</li>
          </ul>
        </div>
        <div class="bg-brand-gray-light rounded-xl p-8 border-t-4 border-brand-navy">
          <div class="text-4xl mb-4">🦁</div>
          <h3 class="font-display text-2xl uppercase font-black text-brand-black mb-1">Lions</h3>
          <div class="text-brand-red font-bold text-sm uppercase tracking-wide mb-4">Ages 7–14</div>
          <p class="text-brand-gray leading-relaxed mb-4">
            Real Brazilian Jiu-Jitsu for kids. Lions students learn actual techniques, drilling, and controlled rolling. Anti-bullying curriculum woven throughout. Competition track available for those who want it.
          </p>
          <ul class="space-y-2 text-brand-black text-sm">
            <li class="flex items-start gap-2"><span>✅</span> Real BJJ — not watered-down</li>
            <li class="flex items-start gap-2"><span>✅</span> Anti-bullying focus built into curriculum</li>
            <li class="flex items-start gap-2"><span>✅</span> Builds confidence and self-defense skills</li>
            <li class="flex items-start gap-2"><span>✅</span> Optional competition track</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- BENEFITS FOR PARENTS -->
  <section class="section-pad bg-brand-gray-light">
    <div class="container-page max-w-5xl">
      <div class="flex flex-col md:flex-row gap-10 items-center">
        <div class="flex-1">
          <img
            src={"/images/adult-bjj-hero.jpg"}
            alt="AllStar kids martial arts class in Union NJ"
            class="rounded-xl w-full object-cover shadow-lg"
            loading="lazy"
          />
        </div>
        <div class="flex-1">
          <h2 class="font-display text-3xl md:text-4xl uppercase font-black text-brand-black mb-4">
            What Parents Tell Us
          </h2>
          <p class="text-brand-gray leading-relaxed mb-5">
            Within the first month, parents consistently report improvements in focus, school behavior, and confidence. This is the program that changes kids.
          </p>
          <ul class="space-y-3 text-brand-black">
            <li class="flex items-start gap-3"><span class="text-xl">🎯</span> Better focus and attention in school</li>
            <li class="flex items-start gap-3"><span class="text-xl">💪</span> Physical confidence and coordination</li>
            <li class="flex items-start gap-3"><span class="text-xl">🛡️</span> Know how to handle bullying without becoming a bully</li>
            <li class="flex items-start gap-3"><span class="text-xl">🤝</span> Respect for adults and peers</li>
            <li class="flex items-start gap-3"><span class="text-xl">😄</span> They actually want to go to class every week</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-5xl">
      <div class="text-center mb-10">
        <div class="eyebrow">What parents say</div>
        <h2 class="text-3xl md:text-4xl text-brand-black">Real Kids. Real Transformations.</h2>
      </div>
      <div class="grid sm:grid-cols-3 gap-6">
        {testimonials.map((t) => (
          <div class="bg-brand-gray-light rounded-xl p-6">
            <div class="text-brand-gold text-xl mb-3">★★★★★</div>
            <p class="text-brand-black leading-relaxed mb-4 italic">"{t.quote}"</p>
            <div class="font-bold text-brand-black">{t.name}</div>
            <div class="text-brand-gray text-sm">{t.program}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECOND FORM -->
  <section class="section-pad bg-brand-black text-white">
    <div class="container-page max-w-5xl">
      <div class="flex flex-col lg:flex-row gap-12 items-center">
        <div class="flex-1 text-center lg:text-left">
          <h2 class="font-display text-3xl md:text-4xl uppercase font-black text-white mb-3">
            Ready to Get Your Child Started?
          </h2>
          <p class="text-gray-300 text-lg mb-6">
            Fill out the form and Coach Jamal will reach out personally to lock in your child's first class. Select Cubs or Lions in the program dropdown.
          </p>
          <div class="space-y-2 text-gray-300 text-sm">
            <div>📍 1166 West Chestnut St, Union, NJ 07083</div>
            <div>📞 <a href="tel:+19083411131" class="underline hover:text-white">(908) 341-1131</a></div>
          </div>
        </div>
        <div class="w-full lg:w-auto lg:min-w-[340px]">
          <LeadForm />
        </div>
      </div>
    </div>
  </section>

  <!-- TOWNS -->
  <section class="section-pad bg-brand-gray-light">
    <div class="container-page max-w-3xl text-center">
      <div class="eyebrow">Nearby towns</div>
      <h2 class="text-2xl md:text-3xl text-brand-black mb-5">Coming From a Surrounding Town?</h2>
      <p class="text-brand-gray leading-relaxed mb-6">Families drive in from all over Union and Essex County for our kids programs. The drive is short — the trial is free.</p>
      <div class="flex flex-wrap gap-2 justify-center">
        {towns.map((t) => (
          <a href={`/trial/${t.slug}/`} class="bg-white hover:bg-brand-navy hover:text-white text-brand-black px-4 py-2 rounded-md text-sm font-bold transition-colors shadow-sm">
            {t.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <FAQ items={faqs} />

</PageLayout>
