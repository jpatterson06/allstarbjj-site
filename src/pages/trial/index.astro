---
import PageLayout from '../../layouts/PageLayout.astro';
import LeadForm from '../../components/LeadForm.astro';
import FAQ from '../../components/FAQ.astro';
import { towns } from '../../lib/towns';


const faqs = [
  { q: "What's actually included?", a: "Two weeks of unlimited classes. You can sample any program — Adult BJJ, Adult Muay Thai, Adult MMA, Cubs (kids 4–6), Lions (kids 7–13). Use of a gi and gear during the trial. A pre-class consultation with Coach Jamal or a senior instructor." },
  { q: "Do I need to pay anything?", a: "No. The trial is genuinely free. No card on file. No locked-in commitment. If you decide it's not for you, you owe us nothing." },
  { q: "When can I start?", a: "Whenever the next class is on the schedule. After you fill out the form, we'll text you to confirm a class time. Most students start within a few days of submitting." },
  { q: "I'm an absolute beginner. Will I be lost?", a: "No. Most of our students walk in with zero experience. We have structured beginner curricula. Your first month is humbling. By month three, you're fine." },
  { q: "Can I bring my kid in for the trial?", a: "Yes. Cubs (ages 4–6) and Lions (ages 7–13) both have free trial access. Same form — just select the kids' program." },
  { q: "What should I wear / bring?", a: "Comfy athletic clothes, water bottle, and an open mind. We provide a gi and any gear you need during the trial." },
  { q: "Is there parking?", a: "Free lot on-site at 1166 West Chestnut St, Union, NJ. Easy in, easy out." },
  { q: "What if I don't live in Union?", a: "Most of our students don't. We have students from Westfield, Springfield, Cranford, Maplewood, Millburn, Mountainside, Roselle Park, and beyond. The drive is worth it." },
];

const testimonials = [
  { name: "Mike R.", program: "Adult BJJ", quote: "I walked in knowing nothing. Coach Jamal had me rolling in the first week. Best decision I made all year." },
  { name: "Sandra T.", program: "Parent — Lions", quote: "My son went from shy and nervous to confident and focused. The coaches genuinely care about the kids." },
  { name: "Carlos M.", program: "Adult Muay Thai", quote: "The two-week trial convinced me immediately. The instruction is legit and the team is welcoming." },
];
---

<PageLayout
  title="Free 2-Week Martial Arts Trial in Union, NJ — AllStar"
  description="Get 2 full weeks free at AllStar Martial Arts in Union, NJ. BJJ, Muay Thai, MMA + kids classes. No contract, no credit card, no pressure."
  ogImage={"/images/adult-bjj-hero.jpg"}
>

  <!-- HERO + FORM -->
  <section class="bg-brand-black text-white">
    <div class="container-page py-14 md:py-20">
      <div class="flex flex-col lg:flex-row gap-12 items-center">
        <div class="flex-1 text-center lg:text-left">
          <div class="inline-block bg-brand-red text-white text-xs font-bold uppercase tracking-widest px-3 py-1 rounded mb-5">
            Limited Spots Available
          </div>
          <h1 class="font-display text-4xl md:text-5xl xl:text-6xl uppercase font-black leading-tight mb-5">
            Get 2 Weeks of Martial Arts Classes
            <span class="text-brand-gold">Completely FREE</span>
          </h1>
          <p class="text-gray-300 text-lg md:text-xl leading-relaxed mb-8">
            BJJ · Muay Thai · MMA · Kids Programs<br />
            No contract. No credit card. Just show up.
          </p>
          <div class="flex flex-wrap gap-3 justify-center lg:justify-start mb-8">
            <span class="bg-white/10 text-white text-sm px-4 py-2 rounded-full">✅ $150+ value — free</span>
            <span class="bg-white/10 text-white text-sm px-4 py-2 rounded-full">✅ Gear provided</span>
            <span class="bg-white/10 text-white text-sm px-4 py-2 rounded-full">✅ All levels welcome</span>
          </div>
          <div class="flex gap-8 justify-center lg:justify-start text-center">
            <div>
              <div class="font-display text-3xl text-brand-gold font-black">500+</div>
              <div class="text-gray-400 text-xs uppercase tracking-wide">Students trained</div>
            </div>
            <div>
              <div class="font-display text-3xl text-brand-gold font-black">15+</div>
              <div class="text-gray-400 text-xs uppercase tracking-wide">Years in Union</div>
            </div>
            <div>
              <div class="font-display text-3xl text-brand-gold font-black">5★</div>
              <div class="text-gray-400 text-xs uppercase tracking-wide">Google rating</div>
            </div>
          </div>
        </div>
        <div class="w-full lg:w-auto lg:min-w-[340px]">
          <LeadForm />
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT'S INCLUDED STRIP -->
  <section class="bg-brand-red text-white py-5">
    <div class="container-page">
      <ul class="flex flex-wrap justify-center gap-x-10 gap-y-2 text-sm font-bold uppercase tracking-wide">
        <li>🥋 Unlimited Classes for 2 Weeks</li>
        <li>🎒 All Gear Provided</li>
        <li>👨‍🏫 Intro with Coach Jamal</li>
        <li>🚫 No Card · No Contract · No Pressure</li>
      </ul>
    </div>
  </section>

  <!-- PHOTO + BENEFITS -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-5xl">
      <div class="flex flex-col md:flex-row gap-10 items-center">
        <div class="flex-1">
          <img
            src={"/images/adult-bjj-hero.jpg"}
            alt="AllStar BJJ class in action"
            class="rounded-xl w-full object-cover shadow-lg"
            loading="lazy"
          />
        </div>
        <div class="flex-1">
          <h2 class="font-display text-3xl md:text-4xl uppercase font-black text-brand-black mb-4">
            You're One Step Away From the Best Shape of Your Life
          </h2>
          <p class="text-brand-gray leading-relaxed mb-5">
            It's never too late to start training. Whether you want to get fit, learn real self-defense, or find a community that pushes you — this is the place.
          </p>
          <ul class="space-y-3 text-brand-black">
            <li class="flex items-start gap-3"><span class="text-xl">💪</span> Build real strength, coordination, and endurance</li>
            <li class="flex items-start gap-3"><span class="text-xl">🧠</span> Sharpen focus, discipline, and stress management</li>
            <li class="flex items-start gap-3"><span class="text-xl">🤝</span> Train with a community that has your back</li>
            <li class="flex items-start gap-3"><span class="text-xl">🥋</span> Learn from Renzo Gracie lineage black belts</li>
            <li class="flex items-start gap-3"><span class="text-xl">👦</span> Kids programs that build confidence for life</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- PROGRAMS -->
  <section class="section-pad bg-brand-gray-light">
    <div class="container-page max-w-5xl">
      <div class="text-center mb-10">
        <div class="eyebrow">Pick your program</div>
        <h2 class="text-3xl md:text-4xl text-brand-black">All 5 Programs Included in the Trial</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        <div class="bg-white p-6 rounded-xl shadow-sm border-l-4 border-brand-navy">
          <h3 class="text-xl font-bold text-brand-black mb-1">Adult BJJ</h3>
          <p class="text-brand-gray text-sm mb-2">Ages 16+ · All levels welcome</p>
          <p class="text-brand-gray text-sm">Renzo Gracie lineage. The most complete grappling system on earth.</p>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm border-l-4 border-brand-red">
          <h3 class="text-xl font-bold text-brand-black mb-1">Adult Muay Thai</h3>
          <p class="text-brand-gray text-sm mb-2">Ages 16+ · All levels welcome</p>
          <p class="text-brand-gray text-sm">Real striking, pad work, and conditioning. No fluff.</p>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm border-l-4 border-brand-black">
          <h3 class="text-xl font-bold text-brand-black mb-1">Adult MMA</h3>
          <p class="text-brand-gray text-sm mb-2">Ages 16+ · All levels welcome</p>
          <p class="text-brand-gray text-sm">IFL and Bellator-coached. The complete fighting system.</p>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm border-l-4 border-brand-gold">
          <h3 class="text-xl font-bold text-brand-black mb-1">Lions — Kids BJJ</h3>
          <p class="text-brand-gray text-sm mb-2">Ages 7–13</p>
          <p class="text-brand-gray text-sm">Real BJJ for kids. Confidence, respect, and focus.</p>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm border-l-4 border-brand-gold">
          <h3 class="text-xl font-bold text-brand-black mb-1">Cubs — Preschool</h3>
          <p class="text-brand-gray text-sm mb-2">Ages 4–6</p>
          <p class="text-brand-gray text-sm">Structure, listening, and fun. The perfect first class.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-5xl">
      <div class="text-center mb-10">
        <div class="eyebrow">What members say</div>
        <h2 class="text-3xl md:text-4xl text-brand-black">Real Students. Real Results.</h2>
      </div>
      <div class="grid sm:grid-cols-3 gap-6">
        {testimonials.map((t) => (
          <div class="bg-brand-gray-light rounded-xl p-6">
            <div class="text-brand-gold text-xl mb-3">★★★★★</div>
            <p class="text-brand-black leading-relaxed mb-4 italic">"{t.quote}"</p>
            <div class="font-bold text-brand-black">{t.name}</div>
            <div class="text-brand-gray text-sm">{t.program}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECOND FORM -->
  <section class="section-pad bg-brand-black text-white">
    <div class="container-page max-w-5xl">
      <div class="flex flex-col lg:flex-row gap-12 items-center">
        <div class="flex-1 text-center lg:text-left">
          <h2 class="font-display text-3xl md:text-4xl uppercase font-black text-white mb-3">
            Ready to Walk In?
          </h2>
          <p class="text-gray-300 text-lg mb-6">
            Fill out the form and Coach Jamal will reach out personally to lock in your first class. Most people start within a few days.
          </p>
          <div class="space-y-2 text-gray-300 text-sm">
            <div>📍 1166 West Chestnut St, Union, NJ 07083</div>
            <div>📞 <a href="tel:+19083411131" class="underline hover:text-white">(908) 341-1131</a></div>
          </div>
        </div>
        <div class="w-full lg:w-auto lg:min-w-[340px]">
          <LeadForm />
        </div>
      </div>
    </div>
  </section>

  <!-- TOWNS -->
  <section class="section-pad bg-brand-gray-light">
    <div class="container-page max-w-3xl text-center">
      <div class="eyebrow">Nearby towns</div>
      <h2 class="text-2xl md:text-3xl text-brand-black mb-5">Coming From a Surrounding Town?</h2>
      <p class="text-brand-gray leading-relaxed mb-6">Students drive in from all over Union and Essex County. The drive is short — the trial is free either way.</p>
      <div class="flex flex-wrap gap-2 justify-center">
        {towns.map((t) => (
          <a href={`/trial/${t.slug}/`} class="bg-white hover:bg-brand-navy hover:text-white text-brand-black px-4 py-2 rounded-md text-sm font-bold transition-colors shadow-sm">
            {t.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <FAQ items={faqs} />

</PageLayout>
