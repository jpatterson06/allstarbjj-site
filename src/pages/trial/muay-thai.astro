---
import PageLayout from '../../layouts/PageLayout.astro';
import LeadForm from '../../components/LeadForm.astro';
import FAQ from '../../components/FAQ.astro';
import { towns } from '../../lib/towns';

const faqs = [
  { q: "Do I need any fighting experience to start Muay Thai?", a: "None at all. Our Muay Thai program is built for people who have never thrown a punch or kick. Coaches break everything down from scratch." },
  { q: "Is Muay Thai good for fitness even if I don't want to compete?", a: "Absolutely. Muay Thai is one of the best full-body workouts you can do. Most of our students train purely for fitness, stress relief, and self-confidence — never compete." },
  { q: "Do I need to buy gear for the trial?", a: "No. We provide gloves and all gear you need during the free trial. Just wear athletic clothes and bring a water bottle." },
  { q: "Do I need to pay anything for the trial?", a: "No. The 2-week trial is completely free. No card on file, no contracts, no pressure." },
  { q: "When can I start?", a: "After you fill out the form, we'll text you to confirm a class time. Most people start within a few days." },
  { q: "Is there parking?", a: "Free lot on-site at 1166 West Chestnut St, Union, NJ. Easy in, easy out." },
];

const testimonials = [
  { name: "David K.", program: "Adult Muay Thai", quote: "I was nervous to start Muay Thai at 35. Best decision I ever made — coaches are patient and I'm in the best shape of my life." },
  { name: "Tanya B.", program: "Adult Muay Thai", quote: "Came in for fitness, stayed for the community. The cardio alone is worth it." },
  { name: "Mike R.", program: "Adult Muay Thai", quote: "Coming from a boxing background, adding Muay Thai took my striking to another level." },
];
---

<PageLayout
  title="Free 2-Week Muay Thai Trial in Union, NJ — AllStar Martial Arts"
  description="Try Adult Muay Thai free for 2 weeks at AllStar Martial Arts in Union, NJ. Punches, kicks, elbows, knees. Great for fitness or competition."
  ogImage={"/images/adult-bjj-hero.jpg"}
>

  <!-- HERO + FORM -->
  <section class="bg-brand-black text-white">
    <div class="container-page py-14 md:py-20">
      <div class="flex flex-col lg:flex-row gap-12 items-center">
        <div class="flex-1 text-center lg:text-left">
          <div class="inline-block bg-brand-red text-white text-xs font-bold uppercase tracking-widest px-3 py-1 rounded mb-5">
            Limited Spots Available
          </div>
          <h1 class="font-display text-4xl md:text-5xl xl:text-6xl uppercase font-black leading-tight mb-5">
            Try Muay Thai
            <span class="text-brand-gold">FREE for 2 Weeks</span>
          </h1>
          <p class="text-gray-300 text-lg md:text-xl leading-relaxed mb-8">
            Stand-up striking — punches, kicks, elbows, knees. The best cardio you'll ever have. Great for fitness, self-defense, or competition.
          </p>
          <div class="flex flex-wrap gap-3 justify-center lg:justify-start mb-8">
            <span class="bg-white/10 text-white text-sm px-4 py-2 rounded-full">✅ All fitness levels</span>
            <span class="bg-white/10 text-white text-sm px-4 py-2 rounded-full">✅ Gear provided</span>
            <span class="bg-white/10 text-white text-sm px-4 py-2 rounded-full">✅ No contract</span>
            <span class="bg-white/10 text-white text-sm px-4 py-2 rounded-full">📍 Union, NJ</span>
          </div>
          <div class="flex gap-8 justify-center lg:justify-start text-center">
            <div>
              <div class="font-display text-3xl text-brand-gold font-black">300+</div>
              <div class="text-gray-400 text-xs uppercase tracking-wide">Students trained</div>
            </div>
            <div>
              <div class="font-display text-3xl text-brand-gold font-black">15+</div>
              <div class="text-gray-400 text-xs uppercase tracking-wide">Years in Union</div>
            </div>
            <div>
              <div class="font-display text-3xl text-brand-gold font-black">5★</div>
              <div class="text-gray-400 text-xs uppercase tracking-wide">Google rating</div>
            </div>
          </div>
        </div>
        <div class="w-full lg:w-auto lg:min-w-[340px]">
          <LeadForm programLocked="Adult Muay Thai" />
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT'S INCLUDED STRIP -->
  <section class="bg-brand-red text-white py-5">
    <div class="container-page">
      <ul class="flex flex-wrap justify-center gap-x-10 gap-y-2 text-sm font-bold uppercase tracking-wide">
        <li>🥊 Unlimited Muay Thai Classes for 2 Weeks</li>
        <li>🎒 All Gear Provided</li>
        <li>👨‍🏫 Intro with Coach Jamal</li>
        <li>🚫 No Card · No Contract · No Pressure</li>
      </ul>
    </div>
  </section>

  <!-- PHOTO + BENEFITS -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-5xl">
      <div class="flex flex-col md:flex-row gap-10 items-center">
        <div class="flex-1">
          <img
            src={"/images/adult-bjj-hero.jpg"}
            alt="AllStar Muay Thai class in Union NJ"
            class="rounded-xl w-full object-cover shadow-lg"
            loading="lazy"
            width="800"
            height="600"
          />
        </div>
        <div class="flex-1">
          <h2 class="font-display text-3xl md:text-4xl uppercase font-black text-brand-black mb-4">
            The Art of 8 Limbs — Built for Everyone
          </h2>
          <p class="text-brand-gray leading-relaxed mb-5">
            Muay Thai uses punches, kicks, elbows, and knees — the most complete striking art in the world. Whether you want to compete or just get in incredible shape, this is your program.
          </p>
          <ul class="space-y-3 text-brand-black">
            <li class="flex items-start gap-3"><span class="text-xl">💪</span> The best full-body cardio workout you'll ever do</li>
            <li class="flex items-start gap-3"><span class="text-xl">🥊</span> Real striking skills — punches, kicks, elbows, knees</li>
            <li class="flex items-start gap-3"><span class="text-xl">🧠</span> Sharpen focus and burn stress like nothing else</li>
            <li class="flex items-start gap-3"><span class="text-xl">🤝</span> A tight-knit community that pushes each other</li>
            <li class="flex items-start gap-3"><span class="text-xl">🎯</span> Coached by fighters with real competition experience</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section-pad bg-brand-gray-light">
    <div class="container-page max-w-5xl">
      <div class="text-center mb-10">
        <div class="eyebrow">What members say</div>
        <h2 class="text-3xl md:text-4xl text-brand-black">Real Muay Thai Students. Real Results.</h2>
      </div>
      <div class="grid sm:grid-cols-3 gap-6">
        {testimonials.map((t) => (
          <div class="bg-white rounded-xl p-6 shadow-sm">
            <div class="text-brand-gold text-xl mb-3">★★★★★</div>
            <p class="text-brand-black leading-relaxed mb-4 italic">"{t.quote}"</p>
            <div class="font-bold text-brand-black">{t.name}</div>
            <div class="text-brand-gray text-sm">{t.program}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECOND FORM -->
  <section class="section-pad bg-brand-black text-white">
    <div class="container-page max-w-5xl">
      <div class="flex flex-col lg:flex-row gap-12 items-center">
        <div class="flex-1 text-center lg:text-left">
          <h2 class="font-display text-3xl md:text-4xl uppercase font-black text-white mb-3">
            Ready to Strike?
          </h2>
          <p class="text-gray-300 text-lg mb-6">
            Fill out the form and Coach Jamal will reach out personally to lock in your first Muay Thai class. Most people start within a few days.
          </p>
          <div class="space-y-2 text-gray-300 text-sm">
            <div>📍 1166 West Chestnut St, Union, NJ 07083</div>
            <div>📞 <a href="tel:+19083411131" class="underline hover:text-white">(908) 341-1131</a></div>
          </div>
        </div>
        <div class="w-full lg:w-auto lg:min-w-[340px]">
          <LeadForm programLocked="Adult Muay Thai" />
        </div>
      </div>
    </div>
  </section>

  <!-- TOWNS -->
  <section class="section-pad bg-brand-gray-light">
    <div class="container-page max-w-3xl text-center">
      <div class="eyebrow">Nearby towns</div>
      <h2 class="text-2xl md:text-3xl text-brand-black mb-5">Coming From a Surrounding Town?</h2>
      <p class="text-brand-gray leading-relaxed mb-6">Students drive in from all over Union and Essex County for Muay Thai. The drive is short — the trial is free.</p>
      <div class="flex flex-wrap gap-2 justify-center">
        {towns.map((t) => (
          <a href={`/trial/${t.slug}/`} class="bg-white hover:bg-brand-navy hover:text-white text-brand-black px-4 py-2 rounded-md text-sm font-bold transition-colors shadow-sm">
            {t.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <FAQ items={faqs} />

</PageLayout>
