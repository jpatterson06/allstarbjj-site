---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import FAQPageSchema from '../components/FAQPageSchema.astro';
import LocalBusinessSchema from '../components/LocalBusinessSchema.astro';

const faqs = [
  { q: "How far is AllStar from Westfield?", a: "About 12–15 minutes via Central Ave or Route 22. 1166 West Chestnut St, Union. Free parking." },
  { q: "Do kids need experience?", a: "No. Most kids start from scratch. The curriculum builds from the ground up." },
  { q: "Can adults try BJJ and Muay Thai at the same time?", a: "Yes. Many adult members train both. They complement each other well." },
  { q: "What's the free trial?", a: "Two weeks, unlimited classes. No card, no contract, no pressure." },
  { q: "How do I sign up?", a: "Fill out the form on this page or call (908) 341-1131. We'll reach out same day." },
];

const city = "Westfield";
---

<Fragment slot="head">
    <LocalBusinessSchema city={city} />
    <FAQPageSchema faqs={faqs} />
  </Fragment>

  <PageLayout
  title="Martial Arts in Westfield, NJ — BJJ, Muay Thai & Kids Classes | AllStar"
  description="Martial arts classes for Westfield, NJ families at AllStar Martial Arts in Union. BJJ, Muay Thai, MMA, and Kids programs. Renzo Gracie black belt. Free 2-week trial."
  ogImage="/images/adult-bjj-hero.jpg"
>
  <PageHero
    eyebrow="15 minutes from Westfield"
    headline="Martial Arts in Westfield, NJ"
    sub="Real instruction, 15 minutes away. BJJ, Muay Thai, MMA, and Kids programs. Free 2-week trial — no contract."
    bgImage="/images/adult-bjj-hero.jpg"
  />

  <!-- Intro -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-3xl">
      <p class="text-lg md:text-xl text-brand-gray leading-relaxed mb-6">
        Westfield has a lot going for it. The downtown, the train, the parks, the schools. What it doesn't have is a Muay Thai program. Or a BJJ instructor with a professional MMA career and ADCC competition record teaching adults and kids 15 minutes away.
      </p>
      <p class="text-lg md:text-xl text-brand-gray leading-relaxed">
        That's what Westfield families find at AllStar Martial Arts in Union. Coach Jamal Patterson is a Renzo Gracie black belt who fought professionally in the IFL and Bellator, won the UWC light heavyweight title, and has been coaching in Union since 2011.
      </p>
    </div>
  </section>

  <!-- BJJ -->
  <section class="section-pad bg-brand-gray-light">
    <div class="container-page max-w-3xl">
      <div class="eyebrow">Brazilian Jiu-Jitsu</div>
      <h2 class="text-3xl md:text-4xl text-brand-black mb-5">BJJ Classes for Westfield Adults</h2>
      <p class="text-brand-gray leading-relaxed mb-4">
        Brazilian Jiu-Jitsu is our main adult program. Ages 16 and up. No experience needed — most students walk in for the first time with zero background and are fine within a few weeks.
      </p>
      <p class="text-brand-gray leading-relaxed mb-4">
        Evening classes at 6, 7, and 8 PM most weekdays. Saturday mornings. Built for Westfield commuters on NJ Transit.
      </p>
      <p class="text-brand-gray leading-relaxed">
        What BJJ gives Westfield adults who stick with it: a real skill that compounds over years. Something you'll still be doing in your 50s when most other gym routines have faded out.
      </p>
    </div>
  </section>

  <!-- Kids -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-3xl">
      <div class="eyebrow">Kids Programs</div>
      <h2 class="text-3xl md:text-4xl text-brand-black mb-5">Kids Martial Arts for Westfield Families</h2>
      <p class="text-brand-gray leading-relaxed mb-5">Westfield is a family town. So is AllStar. Our kids programs split into two groups:</p>
      <div class="space-y-5">
        <div class="bg-brand-gray-light p-6 rounded-lg border-l-4 border-brand-gold">
          <h3 class="text-xl text-brand-black mb-2">Cubs — Ages 4–6</h3>
          <p class="text-brand-gray text-sm leading-relaxed">Preschool martial arts built for kids who still think sitting still is optional. Short bursts of activity, positive reinforcement, big energy. Parents tell us their kids sleep better and listen more after a few weeks.</p>
        </div>
        <div class="bg-brand-gray-light p-6 rounded-lg border-l-4 border-brand-navy">
          <h3 class="text-xl text-brand-black mb-2">Lions — Ages 7–13</h3>
          <p class="text-brand-gray text-sm leading-relaxed">Real Brazilian Jiu-Jitsu for kids who are ready to work. Takedowns, escapes, positions — taught progressively. By the end of the first year, a Lions student can handle themselves in ways most adults can't.</p>
        </div>
      </div>
      <p class="text-brand-gray leading-relaxed mt-5">
        The most common reason Westfield parents bring their kids to AllStar: bullying concerns. A kid who knows they can physically handle a situation almost never has to.
      </p>
    </div>
  </section>

  <!-- Muay Thai -->
  <section class="section-pad bg-brand-navy text-white">
    <div class="container-page max-w-4xl">
      <div class="grid md:grid-cols-2 gap-8">
        <div>
          <div class="eyebrow text-brand-gold">Muay Thai</div>
          <h2 class="text-2xl md:text-3xl mb-4">The One Nobody Else Offers</h2>
          <p class="text-white/90 leading-relaxed">
            Search "Muay Thai near Westfield NJ" and see what comes up. AllStar is the only school in the immediate Westfield area offering authentic Muay Thai — real pad work, real technique, real conditioning. Adults from Westfield who've tried the kickboxing studios and found them shallow have been finding their way to us for years.
          </p>
        </div>
        <div>
          <div class="eyebrow text-brand-gold">MMA</div>
          <h2 class="text-2xl md:text-3xl mb-4">MMA Near Westfield, NJ</h2>
          <p class="text-white/90 leading-relaxed">
            Our MMA program runs for adults 16 and up. Coached by Jamal Patterson — pro MMA fighter, IFL and Bellator veteran, who has cornered UFC athletes from amateur to pro. The complete system if you want the full picture.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Landmarks -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-3xl">
      <div class="eyebrow">If you know Westfield</div>
      <h2 class="text-2xl md:text-3xl text-brand-black mb-5">About 15 Minutes From All Of It</h2>
      <div class="flex flex-wrap gap-2">
        {["Downtown Westfield", "Mindowaskin Park", "Tamaques Park", "Westfield High School", "Westfield Train Station", "Franklin Elementary", "Jefferson Elementary", "Tamaques Elementary", "St. Bartholomew Academy"].map((l) => (
          <span class="bg-brand-gray-light text-brand-gray px-4 py-2 rounded-full text-sm">📍 {l}</span>
        ))}
      </div>
    </div>
  </section>

  <FAQ items={faqs} />

  <CTA
    headline="Two Weeks Free — Westfield Families Welcome"
    sub="Show up. Bring water. We'll handle the rest. No commitment, no pressure."
  />
</PageLayout>
