---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import FAQPageSchema from '../components/FAQPageSchema.astro';
import LocalBusinessSchema from '../components/LocalBusinessSchema.astro';

const faqs = [
  { q: "How far is AllStar from Westfield?", a: "About 12–15 minutes via Central Ave or Route 22. 1166 West Chestnut St, Union. Free parking." },
  { q: "Do kids need experience?", a: "No. Most kids start from scratch. The curriculum builds from the ground up." },
  { q: "Can adults try BJJ and Muay Thai at the same time?", a: "Yes. Many adult members train both. They complement each other well." },
  { q: "What's the free trial?", a: "Two weeks, unlimited classes. No card, no contract, no pressure." },
  { q: "How do I sign up?", a: "Fill out the form on this page or call (908) 341-1131. We'll reach out same day." },
];

const city = "Westfield";
---

<Fragment slot="head">
    <LocalBusinessSchema city={city} />
    <FAQPageSchema faqs={faqs} />
  </Fragment>

  <PageLayout
  title="Martial Arts in Westfield, NJ — BJJ, Muay Thai & Kids Classes | AllStar"
  description="Martial arts classes for Westfield, NJ families at AllStar Martial Arts in Union. BJJ, Muay Thai, MMA, and Kids programs. Renzo Gracie black belt. Free 2-week trial."
  ogImage="/images/adult-bjj-hero.jpg"
>
  <PageHero
    eyebrow="15 minutes from Westfield"
    headline="Martial Arts in Westfield, NJ"
    sub="Real instruction, a straight 15-minute shot down Central Ave. BJJ, Muay Thai, MMA, and Kids programs. Free 2-week trial — no contract."
    bgImage="/images/adult-bjj-hero.jpg"
  />

  <!-- Intro -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-3xl">
      <p class="text-lg md:text-xl text-brand-gray leading-relaxed mb-6">
        Westfield does a lot of things right. Quaint downtown, the Raritan Valley Line into the city, Mindowaskin Park on a Saturday, schools people move here for. The one gap: there's no authentic Muay Thai room in town, and no BJJ coach with a professional MMA record teaching kids and adults a short drive away.
      </p>
      <p class="text-lg md:text-xl text-brand-gray leading-relaxed">
        That drive lands at AllStar Martial Arts in Union — 12 to 15 minutes down Central Ave. Coach Jamal Patterson is a Renzo Gracie black belt who fought in the IFL and Bellator, won the UWC light heavyweight title, and has run the gym as a family business since 2011. Westfield sits right between us and <a href="/scotch-plains/" class="text-brand-navy font-bold hover:text-brand-gold transition-colors">Scotch Plains →</a>, and families from both make the same easy trip.
      </p>
    </div>
  </section>

  <!-- BJJ -->
  <section class="section-pad bg-brand-gray-light">
    <div class="container-page max-w-3xl">
      <div class="eyebrow">Brazilian Jiu-Jitsu</div>
      <h2 class="text-3xl md:text-4xl text-brand-black mb-5">BJJ Classes for Westfield Adults</h2>
      <p class="text-brand-gray leading-relaxed mb-4">
        Brazilian Jiu-Jitsu is our flagship adult program — ages 16 and up. No background required. Most people walk in for the first session with nothing but nerves and find their footing inside a few weeks.
      </p>
      <p class="text-brand-gray leading-relaxed mb-4">
        Evening classes at 6, 7, and 8 PM most weekdays, plus Saturday mornings — timed so a Westfield commuter can get off the train and still make the mats.
      </p>
      <p class="text-brand-gray leading-relaxed">
        Here's what keeps Westfield adults coming back: <a href="/adult-bjj/" class="text-brand-navy font-bold hover:text-brand-gold transition-colors">BJJ →</a> is a skill that compounds. It's the rare thing you'll still be doing in your 50s, long after the treadmill phase and the boot-camp phase have quietly ended.
      </p>
    </div>
  </section>

  <!-- Kids -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-3xl">
      <div class="eyebrow">Kids Programs</div>
      <h2 class="text-3xl md:text-4xl text-brand-black mb-5">Kids Martial Arts for Westfield Families</h2>
      <p class="text-brand-gray leading-relaxed mb-5">Westfield is a family town top to bottom. So is AllStar. The kids program splits into two groups:</p>
      <div class="space-y-5">
        <div class="bg-brand-gray-light p-6 rounded-lg border-l-4 border-brand-gold">
          <h3 class="text-xl text-brand-black mb-2">Cubs — Ages 4–6</h3>
          <p class="text-brand-gray text-sm leading-relaxed">Preschool martial arts for kids who still consider sitting still negotiable. Short bursts of movement, steady encouragement, plenty of energy burned. Parents keep telling us their kids sleep harder and listen better within a couple of weeks.</p>
        </div>
        <div class="bg-brand-gray-light p-6 rounded-lg border-l-4 border-brand-navy">
          <h3 class="text-xl text-brand-black mb-2">Lions — Ages 7–13</h3>
          <p class="text-brand-gray text-sm leading-relaxed">Real Brazilian Jiu-Jitsu for kids ready to put in work. Takedowns, escapes, positions — taught in the right order. A year in, a Lions student can handle themselves in ways most grown adults can't.</p>
        </div>
      </div>
      <p class="text-brand-gray leading-relaxed mt-5">
        The number-one reason Westfield parents first call us: worry about bullying. The quiet truth is that a kid who knows they can handle a situation almost never has to prove it.
      </p>
    </div>
  </section>

  <!-- Muay Thai -->
  <section class="section-pad bg-brand-navy text-white">
    <div class="container-page max-w-4xl">
      <div class="grid md:grid-cols-2 gap-8">
        <div>
          <div class="eyebrow text-brand-gold">Muay Thai</div>
          <h2 class="text-2xl md:text-3xl mb-4">The One Nobody Else Offers</h2>
          <p class="text-white/90 leading-relaxed">
            Type "Muay Thai near Westfield NJ" into your phone and look at how thin the results are. AllStar is the only school in the immediate Westfield–<a href="/cranford/" class="text-brand-navy font-bold hover:text-brand-gold transition-colors">Cranford →</a> area running authentic Muay Thai — real pad work, real technique, real conditioning. Westfield adults who tried the strip-mall kickboxing studios and left underwhelmed have been finding their way to us for years.
          </p>
        </div>
        <div>
          <div class="eyebrow text-brand-gold">MMA</div>
          <h2 class="text-2xl md:text-3xl mb-4">MMA Near Westfield, NJ</h2>
          <p class="text-white/90 leading-relaxed">
            The MMA program runs for adults 16 and up, coached by Jamal Patterson — pro fighter, IFL and Bellator veteran, and a cornerman for UFC athletes from their amateur days up. It's the full picture if you want to see how it all fits together.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Landmarks -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-3xl">
      <div class="eyebrow">If you know Westfield</div>
      <h2 class="text-2xl md:text-3xl text-brand-black mb-5">About 15 Minutes From All Of It</h2>
      <div class="flex flex-wrap gap-2">
        {["Downtown Westfield", "Mindowaskin Park", "Tamaques Park", "Westfield High School", "Westfield Train Station", "Franklin Elementary", "Jefferson Elementary", "Tamaques Elementary", "St. Bartholomew Academy"].map((l) => (
          <span class="bg-brand-gray-light text-brand-gray px-4 py-2 rounded-full text-sm">📍 {l}</span>
        ))}
      </div>
    </div>
  </section>

  <FAQ items={faqs} />

  <CTA
    headline="Two Weeks Free — Westfield Families Welcome"
    sub="Show up. Bring water. We'll handle the rest. No commitment, no pressure."
  />
</PageLayout>
