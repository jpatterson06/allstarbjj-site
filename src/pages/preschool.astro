---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
import FAQ from '../components/FAQ.astro';
import FAQPageSchema from '../components/FAQPageSchema.astro';
import HowToSchema from '../components/HowToSchema.astro';
import VideoSchema from '../components/VideoSchema.astro';
import CTA from '../components/CTA.astro';
import YouTubeShort from '../components/YouTubeShort.astro';

const heroImg = '/images/preschool-kids.jpg';

const faqs = [
  { q: "Is 4 too young?", a: "No. The Cubs program is built for ages 4–6 specifically. Curriculum, attention spans, energy management — all calibrated for that age. Our youngest students do remarkably well." },
  { q: "What if my kid won't listen?", a: "Most preschoolers can't focus for 45 minutes — yet. We meet them where they are. The class is built in short bursts of structure and play. By month two, the focus shows up." },
  { q: "What's the difference between Cubs and Lions?", a: "Cubs (4–6) is more game-based, with shorter focus windows and more coach attention per kid. Lions (7–13) is real BJJ technique with full positional rolling. Different programs, different pacing." },
  { q: "Will my kid get hurt?", a: "No striking, no rough rolling at this age. Cubs is mostly games, motor coordination, and intro grappling concepts. The injury rate is lower than playground recess." },
  { q: "Can siblings train together?", a: "Yes. Many families have a Cubs kid and a Lions kid. Same gym, different classes, same culture." },
  { q: "How long are Cubs classes?", a: "30–40 minutes — calibrated to preschool attention spans. Long enough to learn, short enough to leave wanting more." },
  { q: "Do they need a uniform?", a: "Not for the trial. After they commit, a kids gi runs about $50 and lasts a year." },
  { q: "What if they cry the first day?", a: "Some do. We've seen every version of this. Parents are welcome to stay in the lobby and watch. By week two, almost every kid is running in." },
];

// HowTo steps for the class structure
const classSteps = [
  {
    name: "Bow in",
    text: "Start class the same way every time. Builds ritual and focus before anything else happens. A 30-second moment of togetherness."
  },
  {
    name: "Warm-up games",
    text: "Crawling races, animal walks, balance challenges. The warm-up is half the lesson. Kids are building coordination and motor skills through play."
  },
  {
    name: "One technique",
    text: "Just one move per class — taught with a demo, practiced with a partner. Cubs learn deeper from repetition than from a buffet of techniques."
  },
  {
    name: "Mat game",
    text: "A grappling-themed game that secretly reinforces the technique taught. Kids think they're playing; they're actually learning."
  },
  {
    name: "Bow out",
    text: "End class the same way every time. Predictability is the gift you give a preschooler. They leave knowing what to expect next class."
  }
];
---

<PageLayout
  title="Preschool Martial Arts in Union, NJ — Cubs Program (Ages 4-6) | AllStar"
  description="Preschool martial arts in Union, NJ. The Cubs program (ages 4-6) builds confidence, listening skills, and coordination through age-appropriate fun + structure. Free 2-week trial."
  ogImage={heroImg}
>
  <Fragment slot="head">
    <FAQPageSchema faqs={faqs} />
    <HowToSchema
      title="How a Preschool Martial Arts Class Works"
      description="The Cubs program structure: 30-40 minute classes designed for ages 4-6, building confidence, coordination, and listening skills through play-based learning."
      steps={classSteps}
      totalTime="PT35M"
      yield="Preschoolers with improved coordination, listening skills, confidence, and energy management"
      image={heroImg}
    />
    <VideoSchema
      videoId="5KIOedUNOI8"
      title="AllStar Cubs Preschool Martial Arts Class"
      description="See what a preschool martial arts class looks like at AllStar. Cubs program for ages 4-6."
      duration="PT2M"
      uploadDate="2024-06-15"
    />
  </Fragment>

  <PageHero
    eyebrow="Kids ages 4-6"
    headline="Preschool Martial Arts — Cubs"
    sub="Age-appropriate fun + structure. Confidence, listening skills, energy burn — and a lot of laughing on the mats."
    bgImage={heroImg}
    bgPosition="50% 60%"
    programLocked="Cubs"
  />

  <!-- Intro -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-3xl">
      <p class="text-lg md:text-xl text-brand-gray leading-relaxed">
        Preschool martial arts in Union, NJ for ages 4–6. The Cubs program builds coordination, listening, and confidence through age-appropriate movement and games. 30–40 minute classes built for preschool attention spans. Free 2-week trial, no contract. Saturday mornings and weekday afternoons. Call <strong>(908) 341-1131</strong>.
      </p>
    </div>
  </section>

  <!-- Video — see it in action -->
  <section class="section-pad bg-brand-gray-light">
    <div class="container-page">
      <div class="text-center mb-8">
        <div class="eyebrow">See it in action</div>
        <h2 class="text-2xl md:text-3xl text-brand-black">Little Ones on the Mat</h2>
      </div>
      <YouTubeShort videoId="5KIOedUNOI8" title="AllStar Preschool Martial Arts class" caption="A quick look at our Cubs program in Union, NJ." />
    </div>
  </section>

  <!-- What kids get -->
  <section class="section-pad bg-brand-navy text-white">
    <div class="container-page max-w-5xl">
      <div class="text-center mb-10">
        <div class="eyebrow text-brand-gold">What Cubs Builds</div>
        <h2 class="text-3xl md:text-4xl">Four Core Skills (That Last Beyond Martial Arts)</h2>
      </div>
      <div class="grid sm:grid-cols-2 md:grid-cols-4 gap-5">
        <div class="bg-white/5 backdrop-blur p-5 rounded-lg text-center">
          <div class="text-3xl mb-2">👂</div>
          <h3 class="text-base mb-1 text-brand-gold font-bold">Listening</h3>
          <p class="text-white/80 text-xs">Following 2- and 3-step instructions on the mat translates straight to school and home. Preschoolers learn to absorb and follow through.</p>
        </div>
        <div class="bg-white/5 backdrop-blur p-5 rounded-lg text-center">
          <div class="text-3xl mb-2">🎯</div>
          <h3 class="text-base mb-1 text-brand-gold font-bold">Focus</h3>
          <p class="text-white/80 text-xs">Short structured bursts build the attention muscle preschoolers don't have yet. By week 4, sustained focus shows up.</p>
        </div>
        <div class="bg-white/5 backdrop-blur p-5 rounded-lg text-center">
          <div class="text-3xl mb-2">🤸</div>
          <h3 class="text-base mb-1 text-brand-gold font-bold">Coordination</h3>
          <p class="text-white/80 text-xs">Crawling patterns, rolling, balance — the motor skill groundwork for every sport that comes later in childhood.</p>
        </div>
        <div class="bg-white/5 backdrop-blur p-5 rounded-lg text-center">
          <div class="text-3xl mb-2">😊</div>
          <h3 class="text-base mb-1 text-brand-gold font-bold">Confidence</h3>
          <p class="text-white/80 text-xs">Praise for showing up. Belt stripes for effort. They walk out feeling capable and proud of themselves.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Cubs vs Lions Comparison -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-4xl">
      <div class="text-center mb-10">
        <h2 class="text-3xl md:text-4xl text-brand-black">Cubs vs Lions: What's the Difference?</h2>
        <p class="text-brand-gray mt-3">Not sure if your kid is ready for Cubs? Here's how we structure programs by age.</p>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-sm md:text-base">
          <thead>
            <tr class="border-b-2 border-brand-navy">
              <th class="text-left py-3 px-4 text-brand-navy font-bold">Cubs (4-6)</th>
              <th class="text-left py-3 px-4 text-brand-navy font-bold">Lions (7-13)</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-brand-gray-light">
              <td class="py-3 px-4"><strong>Class Length:</strong> 30-40 minutes</td>
              <td class="py-3 px-4"><strong>Class Length:</strong> 45-60 minutes</td>
            </tr>
            <tr class="border-b border-brand-gray-light">
              <td class="py-3 px-4"><strong>Focus:</strong> Games, play, motor skills</td>
              <td class="py-3 px-4"><strong>Focus:</strong> Real BJJ technique, positions, rolling</td>
            </tr>
            <tr class="border-b border-brand-gray-light">
              <td class="py-3 px-4"><strong>Technique Depth:</strong> 1 move per class</td>
              <td class="py-3 px-4"><strong>Technique Depth:</strong> 2-3 techniques per class</td>
            </tr>
            <tr class="border-b border-brand-gray-light">
              <td class="py-3 px-4"><strong>Rolling:</strong> No competitive rolling</td>
              <td class="py-3 px-4"><strong>Rolling:</strong> Positional rolling, light sparring</td>
            </tr>
            <tr class="border-b border-brand-gray-light">
              <td class="py-3 px-4"><strong>Pace:</strong> Slower, more play</td>
              <td class="py-3 px-4"><strong>Pace:</strong> Fast, instructional</td>
            </tr>
            <tr>
              <td class="py-3 px-4"><strong>Best For:</strong> High-energy kids, coordination building, confidence</td>
              <td class="py-3 px-4"><strong>Best For:</strong> Kids ready for real technique, competitive interest</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-brand-gray text-sm mt-6 text-center">
        <strong>Not sure?</strong> Sign up for a free trial. Our coaches will tell you which class fits your kid.
      </p>
    </div>
  </section>

  <!-- What a class looks like (with HowTo structure) -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-3xl">
      <div class="eyebrow">The class structure</div>
      <h2 class="text-3xl md:text-4xl text-brand-black mb-3">How a Cubs Class Works (Step by Step)</h2>
      <p class="text-brand-gray leading-relaxed mb-8">
        Cubs classes are 30 to 40 minutes — calibrated to preschool attention spans. The same structure every class builds predictability, which is the gift you give a 5-year-old.
      </p>
      
      <div class="space-y-6">
        {classSteps.map((step, index) => (
          <div class="flex gap-4">
            <div class="bg-brand-red text-white rounded-full w-10 h-10 flex items-center justify-center font-bold shrink-0 text-lg">
              {index + 1}
            </div>
            <div>
              <h3 class="text-xl font-bold text-brand-black mb-2">{step.name}</h3>
              <p class="text-brand-gray leading-relaxed">{step.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Parent expectations -->
  <section class="section-pad bg-brand-gray-light">
    <div class="container-page max-w-3xl">
      <div class="eyebrow">For the parents</div>
      <h2 class="text-3xl md:text-4xl text-brand-black mb-5">The Real Reason Parents Keep Their Kids in Cubs</h2>
      <p class="text-brand-gray leading-relaxed mb-4">
        Honest answer? Half the parents who walk in are tired. Their kid has too much energy. Bedtime is a battle. Screen time is winning.
      </p>
      <p class="text-brand-gray leading-relaxed mb-4">
        After a few weeks of Cubs, that math changes. Real physical effort, structured social time, an outlet that's not a tablet. <strong>Kids sleep better. Bedtime gets easier. Mornings are calmer.</strong> The fitness benefit is obvious. The household peace is the surprise.
      </p>
      <p class="text-brand-gray leading-relaxed mb-6">
        We genuinely like this age group. It shows in how we teach and how patient we are.
      </p>
      
      <div class="bg-white p-6 rounded-lg border-l-4 border-brand-red">
        <h4 class="text-lg font-bold text-brand-black mb-3">What Parents Tell Us After Month 1:</h4>
        <ul class="space-y-2 text-brand-gray text-sm">
          <li>✓ "My kid actually listens now"</li>
          <li>✓ "Bedtime is SO much easier"</li>
          <li>✓ "She talks about class all week"</li>
          <li>✓ "He's sleeping deeper"</li>
          <li>✓ "More confidence, less tantrums"</li>
        </ul>
      </div>
    </div>
  </section>

  <FAQ items={faqs} />

  <CTA
    headline="Two Weeks Free. Bring the Energy."
    sub="No commitment, no pressure. Just bring your kid and water. We'll handle the rest."
  />
</PageLayout>
