---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
import FAQ from '../components/FAQ.astro';
import FAQPageSchema from '../components/FAQPageSchema.astro';
import TestimonialSchema from '../components/TestimonialSchema.astro';
import ServiceSchema from '../components/ServiceSchema.astro';
import CTA from '../components/CTA.astro';

const heroImg = '/images/adult-bjj-hero.jpg';

const testimonials = [
  { author: "Matt L., 10-year student", text: "I've been training with Jamal at AllStar for almost 10 years. He's an incredible leader and an even better person — and a beast on the mats on top of that.", rating: 5 },
  { author: "Valentina, BJJ / Muay Thai / MMA", text: "AllStar changed my life. I've made friendships I'll have forever, built real confidence, and the martial arts community here has opened doors for me all over the world.", rating: 5 },
  { author: "Scott A., AllStar student", text: "World-class instructors from the Renzo Gracie lineage. Jamal was one of the most accomplished grapplers in the world during his time.", rating: 5 }
];

const faqs = [
  { q: "I've never trained anything. Will I be lost?", a: "No. Most students walk in untrained. We have a structured beginner curriculum. Your first month is humbling. By month three, you're doing fine." },
  { q: "I'm in my 40s or 50s. Too late?", a: "We have students in their 50s and 60s who started after 40. BJJ rewards technique over strength — age is less of a factor than people assume." },
  { q: "Is BJJ safe?", a: "Lower injury rates than soccer, basketball, or football. We don't strike. We don't drill anything beginners can't recover from." },
  { q: "Can I just train for fitness without competing?", a: "Yes. Most adults never compete and get full benefit." },
  { q: "Can I cross-train Muay Thai too?", a: "Yes. Many of our serious students train both. They reinforce each other." },
  { q: "Do I need to bring my own gi?", a: "Not for the trial. After the trial, you'll need one — about $80–150 and lasts years." },
  { q: "What about parking?", a: "Free lot on-site. Adult class entry doesn't conflict with kids pickup." },
  { q: "What do I wear to my first class?", a: "Comfortable athletic clothes with no zippers or buttons. You don't need your own gi for the trial. Trim your nails, bring water, and show up 10 minutes early so we can get you settled." },
  { q: "How much does it cost after the free trial?", a: "Pricing depends on how often you want to train. We walk you through the options in person at the end of your trial. No pressure and no long-term contract." },
  { q: "Can I observe a class first?", a: "Yes. Walk in any time. We don't hide what we do." },
  { q: "Where can I find adult BJJ or jiu-jitsu near me?", a: "AllStar Martial Arts is at 1166 West Chestnut St, Union, NJ 07083 — off Route 22, easy for commuters from Springfield, Cranford, Kenilworth, Roselle Park, Westfield, and nearby Union County towns. Adult BJJ runs weekday evenings at 6, 7, and 8 PM." },
];
---

<PageLayout
  title="Brazilian Jiu Jitsu in Union, NJ | AllStar BJJ"
  description="Beginner-friendly Brazilian Jiu-Jitsu in Union, NJ with a Renzo Gracie black belt. No contracts. Start your free two-week trial today."
  ogImage={heroImg}
>
  <Fragment slot="head">
    <FAQPageSchema faqs={faqs} />
    <TestimonialSchema testimonials={testimonials} />

    <!-- Service schemas for GMB -->
    <ServiceSchema
      serviceName="Adult Gi BJJ Classes"
      serviceDescription="Adult Brazilian Jiu-Jitsu classes in Union, NJ with Renzo Gracie lineage instruction. Traditional Gi training with technique-focused curriculum for all experience levels."
      serviceType="Adult Gi BJJ Classes"
      pageUrl="/adult-bjj/"
    />
    <ServiceSchema
      serviceName="No-Gi Submission Wrestling"
      serviceDescription="Advanced no-gi submission wrestling and grappling training for adults. Focus on leg lock systems, heel hooks, and submission-oriented ground fighting."
      serviceType="No-Gi Submission Wrestling"
      pageUrl="/adult-bjj/"
    />
    <ServiceSchema
      serviceName="BJJ for Adults 40+"
      serviceDescription="Brazilian Jiu-Jitsu classes specifically designed for adults over 40. Lower impact, technique-focused training that emphasizes longevity and enjoyment."
      serviceType="BJJ for Adults 40+"
      pageUrl="/bjj-over-40/"
    />
    <ServiceSchema
      serviceName="Competition Tournament Coaching"
      serviceDescription="Specialized coaching for BJJ competition training and tournament preparation. Includes technique refinement, match strategy, and conditioning for competitors."
      serviceType="Competition Tournament Coaching"
      pageUrl="/adult-bjj/"
    />
    
  </Fragment>

  <PageHero
    eyebrow="Ages 16+"
    headline="Brazilian Jiu-Jitsu Classes in Union, NJ"
    sub="Renzo Gracie lineage since 2011. Real coaching. No ego. Schedule your free trial this week — no contract, no pressure."
    bgImage={heroImg}
    programLocked="Adult BJJ"
  />

  <!-- Intro -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-3xl">
      <p class="text-lg md:text-xl text-brand-gray leading-relaxed">
        Brazilian Jiu-Jitsu classes in Union, NJ for complete beginners and experienced grapplers alike, taught by Jamal Patterson — a 4th-degree black belt under Renzo Gracie, ADCC veteran, and former pro MMA fighter. Beginners welcome, no experience needed. Lock in your free trial now — no contract. Evening classes at 6, 7, and 8 PM. Built for working adults and NJ Transit commuters.
      </p>
    </div>
  </section>

  <!-- What is BJJ -->
  <section class="section-pad bg-brand-gray-light">
    <div class="container-page max-w-3xl">
      <div class="eyebrow">What it actually is</div>
      <h2 class="text-3xl md:text-4xl text-brand-black mb-5">Real Adult BJJ — Not "BJJ-Inspired Fitness"</h2>
      <p class="text-brand-gray leading-relaxed mb-4">
        Brazilian Jiu-Jitsu is a grappling-based martial art. No striking. The whole game is leverage, position, and submission. The premise — built into the art a hundred years ago by Helio Gracie because he was a small man — is that <strong>technique should beat strength</strong>. And it does, when it's taught right.
      </p>
      <p class="text-brand-gray leading-relaxed">
        Our adult program runs separately from kids and from preschoolers. Real adult curriculum. Real adult intensity. Real adult students at every belt level.
      </p>
    </div>
  </section>

  <!-- Who this is for -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-4xl">
      <div class="text-center mb-10">
        <div class="eyebrow">Who this is for</div>
        <h2 class="text-3xl md:text-4xl text-brand-black">If You See Yourself Here, Come In</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-6 md:gap-8">
        <div class="bg-brand-gray-light p-6 rounded-lg border-l-4 border-brand-navy">
          <h3 class="text-xl text-brand-black mb-2">The working adult</h3>
          <p class="text-brand-gray text-sm md:text-base leading-relaxed">Treadmills don't compound. The technique you learn this month will still be in your body in ten years. The fitness benefit is huge. The skill benefit is bigger.</p>
        </div>
        <div class="bg-brand-gray-light p-6 rounded-lg border-l-4 border-brand-navy">
          <h3 class="text-xl text-brand-black mb-2">The "I've thought about it for a year" person</h3>
          <p class="text-brand-gray text-sm md:text-base leading-relaxed">Most of our students "thought about" BJJ for a year before walking in. The dread on the drive over is universal. Two months in, you wonder why you waited.</p>
        </div>
        <div class="bg-brand-gray-light p-6 rounded-lg border-l-4 border-brand-navy">
          <h3 class="text-xl text-brand-black mb-2">The cross-trainer</h3>
          <p class="text-brand-gray text-sm md:text-base leading-relaxed">Trained other martial arts and want depth? BJJ has more depth per technique than any martial art I've trained. A decade in, you're still finding new applications.</p>
        </div>
        <div class="bg-brand-gray-light p-6 rounded-lg border-l-4 border-brand-navy">
          <h3 class="text-xl text-brand-black mb-2">The parent setting an example</h3>
          <p class="text-brand-gray text-sm md:text-base leading-relaxed">Your kids notice. When you train, they understand consistency, discipline, and showing up.</p>
        </div>
        <div class="bg-brand-gray-light p-6 rounded-lg border-l-4 border-brand-navy md:col-span-2">
          <h3 class="text-xl text-brand-black mb-2">The woman wondering if she'll fit in</h3>
          <p class="text-brand-gray text-sm md:text-base leading-relaxed">We have women at every belt level — including a current female brown belt who trains with men twice her size and holds her own. Leverage and technique work, regardless of who's using them.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- What a class looks like -->
  <section class="section-pad bg-brand-navy text-white">
    <div class="container-page max-w-4xl">
      <div class="eyebrow text-brand-gold">What a class looks like</div>
      <h2 class="text-3xl md:text-4xl mb-8">Your First Six Months — Fundamentals</h2>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="bg-white/5 backdrop-blur p-6 rounded-lg">
          <div class="font-display text-5xl text-brand-gold mb-2">10<span class="text-xl">min</span></div>
          <h3 class="text-lg mb-2">Warm-up</h3>
          <p class="text-white/80 text-sm">Shrimping, rolls, light movement. Get the blood moving.</p>
        </div>
        <div class="bg-white/5 backdrop-blur p-6 rounded-lg">
          <div class="font-display text-5xl text-brand-gold mb-2">35<span class="text-xl">min</span></div>
          <h3 class="text-lg mb-2">Technique</h3>
          <p class="text-white/80 text-sm">Drill 1–2 specific techniques with a partner. This is where the learning happens.</p>
        </div>
        <div class="bg-white/5 backdrop-blur p-6 rounded-lg">
          <div class="font-display text-5xl text-brand-gold mb-2">15<span class="text-xl">min</span></div>
          <h3 class="text-lg mb-2">Live rolling</h3>
          <p class="text-white/80 text-sm">Apply what you learned at controlled intensity. Tapping is normal, expected, respected.</p>
        </div>
      </div>
      <p class="mt-8 text-white/90 leading-relaxed">
        After six months, you can join general adult classes that include open rolling and more advanced curriculum. You don't have to roll hard your first months. We pair beginners with experienced training partners who guide rather than test. <strong class="text-brand-gold">There's no machismo problem at AllStar.</strong>
      </p>
    </div>
  </section>


  <!-- Schedule -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-3xl">
      <div class="eyebrow">When we train</div>
      <h2 class="text-3xl md:text-4xl text-brand-black mb-5">BJJ Class Schedule</h2>
      <p class="text-brand-gray leading-relaxed mb-4">
        Adult classes run <strong>Monday through Friday at 6:00, 7:00, and 8:00 PM</strong>, with <strong>Saturday classes at 10:00 AM and 12:00 PM</strong>. The evening slots are built for people who work all day and commute home on Route 22, the Parkway, or NJ Transit.
      </p>
      <p class="text-brand-gray leading-relaxed">
        New to jiu-jitsu? Start with your free two-week trial. We'll tell you which classes to hit first. <a href="/trial/bjj/" class="text-brand-navy font-bold underline decoration-brand-gold hover:text-brand-gold">Book your free BJJ trial</a>.
      </p>
    </div>
  </section>

  <!-- Lineage -->
  <section class="section-pad bg-white">
    <div class="container-page grid md:grid-cols-2 gap-12 items-center">
      <div>
        <div class="eyebrow">The lineage</div>
        <h2 class="text-3xl md:text-4xl text-brand-black mb-5">Why Lineage Actually Matters</h2>
        <p class="text-brand-gray leading-relaxed mb-4">
          A lot of schools claim BJJ. Few have the line of instruction to back it up.
        </p>
        <p class="text-brand-gray leading-relaxed mb-4">
          I'm Jamal Patterson, and I trained directly under Renzo Gracie at his academy in New York. The wall in our gym shows the line: <strong>Carlos Gracie → Robson Gracie → Renzo Gracie → me</strong>. The teaching methodology is the one Renzo learned inside the Gracie family and passed to me.
        </p>
        <p class="text-brand-gray leading-relaxed">
          Not a franchise template. Not a third-generation watered-down version. The real thing.
        </p>
      </div>
      <div>
        <img
          src="/images/adult-class.jpg"
          alt="Adult Brazilian Jiu-Jitsu class at AllStar Martial Arts in Union, NJ"
          class="rounded-lg shadow-lg w-full"
          loading="lazy"
          width="482"
          height="630"
        />
      </div>
    </div>
  </section>

  <!-- Why AllStar specifically -->
  <section class="section-pad bg-brand-gray-light">
    <div class="container-page max-w-4xl">
      <div class="text-center mb-10">
        <div class="eyebrow">Why AllStar specifically</div>
        <h2 class="text-3xl md:text-4xl text-brand-black">Four Reasons Adults Choose Us</h2>
      </div>
      <div class="space-y-6">
        <div class="bg-white p-6 md:p-7 rounded-lg shadow-sm">
          <h3 class="text-xl text-brand-black mb-2">A coach who actually competed</h3>
          <p class="text-brand-gray leading-relaxed">Pro MMA fighter, ADCC veteran, fought in the IFL and Bellator, won the UWC light heavyweight title. The technique I teach was tested under stadium lights with money on the line.</p>
        </div>
        <div class="bg-white p-6 md:p-7 rounded-lg shadow-sm">
          <h3 class="text-xl text-brand-black mb-2">A real adult curriculum</h3>
          <p class="text-brand-gray leading-relaxed">Many gyms run adult classes that are "kids classes for big people." We don't. The progression assumes adult learning patterns and adult goals.</p>
        </div>
        <div class="bg-white p-6 md:p-7 rounded-lg shadow-sm">
          <h3 class="text-xl text-brand-black mb-2">A community that's unusually good</h3>
          <p class="text-brand-gray leading-relaxed">BJJ communities are tight by nature. Ours is tighter than most. People notice when you don't show up. They tell you you're improving when you don't see it yourself.</p>
        </div>
        <div class="bg-white p-6 md:p-7 rounded-lg shadow-sm">
          <h3 class="text-xl text-brand-black mb-2">A proven foundation for self defense</h3>
          <p class="text-brand-gray leading-relaxed">BJJ is practical self defense. Real leverage. Real control. Real escapes. <a href="/self-defense/" class="text-brand-navy font-bold hover:text-brand-gold transition-colors">Learn more about our self defense program →</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-4xl">
      <div class="text-center mb-10">
        <div class="eyebrow">What students say</div>
        <h2 class="text-3xl md:text-4xl text-brand-black">From the People on the Mats</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        <blockquote class="bg-brand-gray-light p-6 rounded-lg">
          <div class="text-brand-gold text-xl mb-3">★★★★★</div>
          <p class="text-brand-gray italic mb-4 text-sm leading-relaxed">"I've been training with Jamal at AllStar for almost 10 years. He's an incredible leader and an even better person — and a beast on the mats on top of that."</p>
          <footer class="text-brand-black font-bold text-sm">— Matt L., 10-year student</footer>
        </blockquote>
        <blockquote class="bg-brand-gray-light p-6 rounded-lg">
          <div class="text-brand-gold text-xl mb-3">★★★★★</div>
          <p class="text-brand-gray italic mb-4 text-sm leading-relaxed">"AllStar changed my life. I've made friendships I'll have forever, built real confidence, and the martial arts community here has opened doors for me all over the world."</p>
          <footer class="text-brand-black font-bold text-sm">— Valentina, BJJ / Muay Thai / MMA</footer>
        </blockquote>
        <blockquote class="bg-brand-gray-light p-6 rounded-lg">
          <div class="text-brand-gold text-xl mb-3">★★★★★</div>
          <p class="text-brand-gray italic mb-4 text-sm leading-relaxed">"World-class instructors from the Renzo Gracie lineage. Jamal was one of the most accomplished grapplers in the world during his time."</p>
          <footer class="text-brand-black font-bold text-sm">— Scott A., AllStar student</footer>
        </blockquote>
      </div>
    </div>
  </section>


  <!-- Towns + location -->
  <section class="section-pad bg-brand-gray-light">
    <div class="container-page max-w-4xl">
      <div class="eyebrow">Where we are</div>
      <h2 class="text-3xl md:text-4xl text-brand-black mb-5">BJJ Near Union, Springfield, Cranford &amp; Kenilworth</h2>
      <p class="text-brand-gray leading-relaxed mb-6">
        AllStar Martial Arts is at <strong>1166 West Chestnut St, Union, NJ 07083</strong>, right off Route 22 with free on-site parking. Adults drive in for jiu-jitsu from all over Union and Essex County:
      </p>
      <ul class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-6">
        <li><a href="/union/" class="text-brand-navy font-bold underline decoration-brand-gold hover:text-brand-gold">Union</a></li>
        <li><a href="/springfield/" class="text-brand-navy font-bold underline decoration-brand-gold hover:text-brand-gold">Springfield</a></li>
        <li><a href="/cranford/" class="text-brand-navy font-bold underline decoration-brand-gold hover:text-brand-gold">Cranford</a></li>
        <li><a href="/kenilworth/" class="text-brand-navy font-bold underline decoration-brand-gold hover:text-brand-gold">Kenilworth</a></li>
        <li><a href="/roselle-park/" class="text-brand-navy font-bold underline decoration-brand-gold hover:text-brand-gold">Roselle Park</a></li>
        <li><a href="/mountainside/" class="text-brand-navy font-bold underline decoration-brand-gold hover:text-brand-gold">Mountainside</a></li>
        <li><a href="/maplewood/" class="text-brand-navy font-bold underline decoration-brand-gold hover:text-brand-gold">Maplewood</a></li>
        <li><a href="/millburn/" class="text-brand-navy font-bold underline decoration-brand-gold hover:text-brand-gold">Millburn</a></li>
        <li><a href="/summit/" class="text-brand-navy font-bold underline decoration-brand-gold hover:text-brand-gold">Summit</a></li>
        <li><a href="/westfield/" class="text-brand-navy font-bold underline decoration-brand-gold hover:text-brand-gold">Westfield</a></li>
      </ul>
      <h3 class="text-xl text-brand-black mb-3">Keep reading before your first class</h3>
      <ul class="space-y-2 text-brand-gray">
        <li><a href="/blog/adult-bjj/adult-bjj-union-nj-beginners-complete-guide/" class="text-brand-navy font-bold underline decoration-brand-gold hover:text-brand-gold">Adult BJJ in Union, NJ: a beginner's complete guide</a></li>
        <li><a href="/blog/adult-bjj/first-bjj-class-what-to-expect/" class="text-brand-navy font-bold underline decoration-brand-gold hover:text-brand-gold">What to expect in your first BJJ class</a></li>
        <li><a href="/blog/adult-bjj/gi-vs-no-gi-beginners/" class="text-brand-navy font-bold underline decoration-brand-gold hover:text-brand-gold">Gi vs. no-gi: which should beginners start with?</a></li>
        <li><a href="/bjj-for-women/" class="text-brand-navy font-bold underline decoration-brand-gold hover:text-brand-gold">BJJ for women</a> · <a href="/bjj-over-40/" class="text-brand-navy font-bold underline decoration-brand-gold hover:text-brand-gold">BJJ for adults over 40</a> · <a href="/kids-bjj/" class="text-brand-navy font-bold underline decoration-brand-gold hover:text-brand-gold">Kids BJJ</a></li>
      </ul>
    </div>
  </section>

  <FAQ items={faqs} />

  <CTA
    headline="Two Weeks Free. No Contract."
    sub="Show up. Bring water. We'll handle the rest. If we're not for you, you owe us nothing."
  />
</PageLayout>
