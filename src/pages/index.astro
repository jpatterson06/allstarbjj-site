---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/Hero.astro';
import ProgramCard from '../components/ProgramCard.astro';
import Testimonials from '../components/Testimonials.astro';
import CTA from '../components/CTA.astro';
import YouTubeShort from '../components/YouTubeShort.astro';
import FAQ from '../components/FAQ.astro';
import FAQPageSchema from '../components/FAQPageSchema.astro';

// Homepage FAQ — natural-language questions that match how people (and AI search
// assistants) actually ask for a gym near them. Also feeds FAQ rich results.
const faqs = [
  { q: "Where can I find Brazilian Jiu-Jitsu near me in Union, NJ?", a: "AllStar Martial Arts is at 1166 West Chestnut St in Union, NJ 07083 — off Route 22, minutes from Springfield, Cranford, Kenilworth, Roselle Park, and Union County towns nearby. We teach adult and kids Brazilian Jiu-Jitsu under a Renzo Gracie black belt." },
  { q: "What martial arts classes do you offer?", a: "Brazilian Jiu-Jitsu (BJJ), Muay Thai, and MMA for adults 16+, plus kids martial arts for ages 4–13 (Cubs 4–6 and Lions 7–13). Beginners are welcome in every program." },
  { q: "Do you have a free trial?", a: "Yes. New students get a free 2-week trial — unlimited classes, no contract and no card required. Call (908) 341-1131 or book online to claim a spot." },
  { q: "Who teaches at AllStar Martial Arts?", a: "Head instructor and founder Jamal Patterson is a 4th-degree Brazilian Jiu-Jitsu black belt under Renzo Gracie, an ADCC veteran, and a former pro MMA fighter (IFL, Bellator). The gym has served Union, NJ since 2011." },
  { q: "What towns near Union do you serve?", a: "AllStar serves Union and the surrounding Union and Essex County area, including Springfield, Cranford, Kenilworth, Roselle Park, Mountainside, Westfield, Maplewood, Millburn, Summit, and Scotch Plains." },
];

const programs = [
  {
    title: 'Brazilian Jiu Jitsu',
    ages: 'Ages 16+',
    href: '/adult-bjj/',
    blurb: 'The gentle art. Beginner-friendly. Every black belt in here started right where you are. Claim your free trial spot now.',
    image: '/images/adult-bjj-hero.jpg',
  },
  {
    title: 'Muay Thai',
    ages: 'Ages 16+',
    href: '/adult-muay-thai/',
    blurb: 'Striking, conditioning, and stress relief. You don\'t need to be in shape — you\'ll get in shape. Bring water + comfy clothes.',
    image: '/images/muay-thai-pads.jpg',
  },
  {
    title: 'MMA',
    ages: 'Ages 16+',
    href: '/adult-mma/',
    blurb: 'The full mix: striking + grappling + clinch. Coached by Jamal Patterson — pro MMA fighter and ADCC veteran who has cornered UFC fighters.',
    image: '/images/mma-team.jpg',
  },
  {
    title: 'Lions',
    ages: 'Kids ages 7-13',
    href: '/kids/',
    blurb: 'Real techniques. Confidence + bullyproofing + discipline. The structure kids that age need with the energy they want.',
    image: '/images/kids-martial-arts.jpg',
  },
  {
    title: 'Cubs',
    ages: 'Kids ages 4-6',
    href: '/preschool/',
    blurb: 'Age-appropriate fun + structure. Confidence, listening skills, energy burn — and a lot of laughing on the mats.',
    image: '/images/preschool-kids.jpg',
  },
];

// Hero: wide gym shot — adults rolling on the red mats, lineage wall in the back.
// About block: team WSOF photo with Snoop — strong "real coach, real network" signal.
const heroImg = '/images/union-mat.jpg';
const aboutImg = '/images/mma-team.jpg';
---

<PageLayout
  title="Martial Arts in Union, NJ — AllStar | BJJ, Muay Thai, MMA + Kids Classes"
  description="Free 2-week trial at AllStar Martial Arts in Union, NJ. Brazilian Jiu Jitsu, Muay Thai, MMA + kids classes (ages 4-13). Family-owned since 2011. Beginner-friendly."
  ogImage={heroImg}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SportsActivityLocation",
    "name": "AllStar Martial Arts",
    "description": "Brazilian Jiu-Jitsu, Muay Thai, MMA, and Kids martial arts in Union, NJ. Renzo Gracie black belt. Family-owned since 2011.",
    "url": "https://allstarbjj.com",
    "telephone": "(908) 341-1131",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "1166 West Chestnut St",
      "addressLocality": "Union",
      "addressRegion": "NJ",
      "postalCode": "07083",
      "addressCountry": "US"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 40.6925196,
      "longitude": -74.2863264
    },
    "hasMap": "https://maps.app.goo.gl/cBJKvZMvtEjfTgNY9",
    "openingHours": ["Mo-Fr 09:00-21:00", "Sa 09:00-13:00"],
    "priceRange": "$$",
    "sameAs": ["https://www.facebook.com/allstarbjjmma", "https://www.instagram.com/allstar_martialarts/"]
  })} />

  <Hero
    eyebrow="BJJ • Muay Thai • MMA • Kids — Since 2011"
    headline="Martial Arts in Union, NJ"
    bgImage={heroImg}
    bgPosition="50% 60%"
  />

  <!-- Intro / summary — first thing after the hero. Written as plain, factual,
       self-contained sentences so both Google and AI search can quote it. -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-3xl text-center">
      <h2 class="text-3xl md:text-4xl text-brand-black mb-5">Brazilian Jiu-Jitsu, Muay Thai &amp; MMA in Union, NJ</h2>
      <p class="text-brand-gray text-base md:text-lg leading-relaxed">
        AllStar Martial Arts is a family-owned Brazilian Jiu-Jitsu, Muay Thai, and MMA gym in Union, New Jersey, serving Union County since 2011. If you've been searching for jiu-jitsu, kickboxing, or a martial arts class near you, our adult programs (ages 16+) and kids classes (ages 4–13) are taught by Renzo Gracie black belt Jamal Patterson. Beginners welcome — start with a free two-week trial, no contract.
      </p>
    </div>
  </section>

  <!-- Testimonials section (after hero) -->
  <Testimonials maxItems={6} />

  <!-- About our programs -->
  <section class="section-pad bg-brand-gray-light">
    <div class="container-page">
      <div class="text-center mb-10 md:mb-12">
        <div class="eyebrow">What we offer</div>
        <h2 class="text-3xl md:text-5xl text-brand-black">Our Classes: BJJ, Muay Thai, MMA &amp; Kids Martial Arts</h2>
        <div class="w-16 h-1 bg-brand-navy mx-auto mt-4"></div>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {programs.map((p) => <ProgramCard {...p} />)}
      </div>
    </div>
  </section>

  <!-- About / Coach Jamal block -->
  <section class="section-pad bg-white">
    <div class="container-page grid md:grid-cols-2 gap-10 md:gap-16 items-center">
      <div>
        <div class="eyebrow">Meet Coach Jamal</div>
        <h2 class="text-3xl md:text-5xl text-brand-black mb-5">Real Lineage. Real Coaching.<br/>No Ego.</h2>
        <p class="text-brand-gray text-base md:text-lg mb-4 leading-relaxed">
          <strong>Jamal "The Suit" Patterson</strong> is a 4th degree black belt
          under Renzo Gracie, ADCC veteran, former pro MMA fighter, and UWC Light
          Heavyweight Champion. He's fought in the IFL, Bellator, and UWC — and
          cornered UFC fighters from amateur debut to pro ranks.
        </p>
        <p class="text-brand-gray text-base md:text-lg mb-6 leading-relaxed">
          But what matters at AllStar is the room. The vibe is <em>coach
          first, salesperson never</em>. Beginners and advanced students train
          side by side, and the gym is better for it. You'll know within one
          class whether it fits.
        </p>
        <a href="/about-us/" class="btn-primary">Learn more about us</a>
      </div>
      <div class="relative">
        <img
          src={aboutImg}
          alt="Coach Jamal Patterson with the AllStar MMA team in Union, NJ"
          class="w-full rounded-lg shadow-lg"
          loading="lazy"
          width="960"
          height="640"
        />
        <div class="absolute -bottom-4 -right-4 bg-brand-navy text-white p-4 md:p-5 rounded-lg shadow-xl hidden md:block">
          <div class="font-display text-3xl text-brand-gold">★★★★★</div>
          <div class="text-xs uppercase tracking-wider mt-1">Trusted by hundreds<br/>of NJ families</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why families pick us — stats / proof bar -->
  <section class="bg-brand-navy text-white py-12 md:py-16">
    <div class="container-page grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-10 text-center">
      <div>
        <div class="font-display text-4xl md:text-5xl text-brand-gold mb-1">15</div>
        <div class="text-xs md:text-sm uppercase tracking-widest">Years in Union</div>
      </div>
      <div>
        <div class="font-display text-4xl md:text-5xl text-brand-gold mb-1">ADCC</div>
        <div class="text-xs md:text-sm uppercase tracking-widest">Veteran</div>
      </div>
      <div>
        <div class="font-display text-4xl md:text-5xl text-brand-gold mb-1">★</div>
        <div class="text-xs md:text-sm uppercase tracking-widest">Renzo Gracie<br/>Black Belt</div>
      </div>
      <div>
        <div class="font-display text-4xl md:text-5xl text-brand-gold mb-1">2 wks</div>
        <div class="text-xs md:text-sm uppercase tracking-widest">Free Trial<br/>No Commitment</div>
      </div>
    </div>
  </section>

  <!-- Rules of the Academy -->
  <section class="section-pad bg-brand-gray-light">
    <div class="container-page">
      <div class="text-center mb-8">
        <div class="eyebrow">How we train</div>
        <h2 class="text-3xl md:text-4xl text-brand-black">Rules of the Academy</h2>
        <p class="text-brand-gray mt-3 max-w-xl mx-auto">The culture here isn't an accident. Coach Jamal breaks down exactly how AllStar works — and why it works.</p>
      </div>
      <YouTubeShort videoId="MWEknULk4pg" title="AllStar Martial Arts Academy Rules" caption="The culture, the expectations, and what makes AllStar different." />
    </div>
  </section>

  <!-- FAQ — natural-language Q&A for local + AI search, backed by FAQ schema -->
  <FAQPageSchema faqs={faqs} slot="head" />
  <FAQ heading="Martial Arts in Union, NJ — FAQ" items={faqs} />

  <CTA />
</PageLayout>
