---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
import FAQ from '../components/FAQ.astro';
import FAQPageSchema from '../components/FAQPageSchema.astro';
import LocalBusinessSchema from '../components/LocalBusinessSchema.astro';
import CTA from '../components/CTA.astro';

const city = "Scotch Plains";

const faqs = [
  { q: "How far is AllStar from Scotch Plains?", a: "About 12 minutes via Route 22. 1166 West Chestnut St, Union. Free parking on-site." },
  { q: "What programs are available?", a: "Adult BJJ, Muay Thai, and MMA (ages 16+). Kids Lions (7–13) and Cubs (4–6). Summer camp runs seasonally." },
  { q: "Do I need experience?", a: "No. Most students — adults and kids — start with none." },
  { q: "Can I watch a class before enrolling my child?", a: "Yes. Walk in any time. We don't hide what we do." },
  { q: "What's the free trial?", a: "Two weeks of unlimited classes. Adults can try any program. Kids can try their age group. No card required, no contract, no pressure." },
  { q: "How do I start?", a: "Fill out the form on this page or call (908) 341-1131. We'll text to confirm a class time." },
];
---

<PageLayout
  title="Martial Arts in Scotch Plains, NJ — BJJ, Muay Thai & Kids Classes | AllStar"
  description="Martial arts classes for Scotch Plains, NJ families at AllStar Martial Arts in Union. BJJ, Muay Thai, MMA, and Kids programs. Renzo Gracie black belt. Free 2-week trial."
  ogImage="/images/adult-bjj-hero.jpg"
>
  <Fragment slot="head">
    <LocalBusinessSchema city={city} />
    <FAQPageSchema faqs={faqs} />
  </Fragment>

  <PageHero
    eyebrow="12 minutes from Scotch Plains"
    headline="Martial Arts in Scotch Plains, NJ"
    sub="Brazilian Jiu-Jitsu, Muay Thai, MMA, and Kids programs — about 12 minutes down Route 22 from downtown Scotch Plains. Free 2-week trial, no contract."
    bgImage="/images/adult-bjj-hero.jpg"
  />

  <!-- Intro — accurate description of AllStar + the Scotch Plains connection (verified facts only) -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-3xl">
      <p class="text-lg md:text-xl text-brand-gray leading-relaxed mb-6">
        AllStar Martial Arts is a family-owned Brazilian Jiu-Jitsu, Muay Thai, and MMA school at 1166 West Chestnut St in Union, NJ — about <strong>12 minutes from downtown Scotch Plains</strong>, an easy run east on Route 22, with free parking on-site. We've taught adults and kids here since 2011.
      </p>
      <p class="text-lg md:text-xl text-brand-gray leading-relaxed mb-6">
        Head coach Jamal Patterson is a 4th-degree Brazilian Jiu-Jitsu black belt under Renzo Gracie, an ADCC veteran, and a former professional MMA fighter with wins in the IFL and Bellator. That competition background is what sets AllStar apart from the fitness-boxing and add-on BJJ classes around Scotch Plains.
      </p>
      <p class="text-lg md:text-xl text-brand-gray leading-relaxed">
        Adults train BJJ, Muay Thai, kickboxing, and MMA (ages 16+); kids have Cubs (4–6) and Lions (7–13). Every new student starts with a free two-week trial — no contract, no card.
      </p>
    </div>
  </section>

  <!-- Google Business location embedded — directions from Scotch Plains to the gym -->
  <section class="section-pad bg-brand-gray-light">
    <div class="container-page max-w-4xl">
      <div class="text-center mb-6">
        <div class="eyebrow">Find us from Scotch Plains</div>
        <h2 class="text-2xl md:text-3xl text-brand-black">12 Minutes Down Route 22</h2>
      </div>
      <iframe
        title="Directions from Scotch Plains, NJ to AllStar Martial Arts, 1166 West Chestnut St, Union, NJ"
        src="https://maps.google.com/maps?saddr=Scotch+Plains,+NJ&amp;daddr=1166+West+Chestnut+St,+Union,+NJ+07083&amp;output=embed"
        class="w-full h-72 md:h-80 rounded-lg border-0"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
      <p class="text-center mt-4 text-brand-gray">
        1166 West Chestnut St, Union, NJ 07083 · <a href="https://maps.app.goo.gl/cBJKvZMvtEjfTgNY9" target="_blank" rel="noopener" class="text-brand-navy font-bold hover:text-brand-gold transition-colors">View AllStar on Google Maps →</a>
      </p>
    </div>
  </section>

  <!-- BJJ -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-3xl">
      <div class="eyebrow">Brazilian Jiu-Jitsu</div>
      <h2 class="text-3xl md:text-4xl text-brand-black mb-5">BJJ Classes for Scotch Plains Adults</h2>
      <p class="text-brand-gray leading-relaxed mb-4">
        Brazilian Jiu-Jitsu is our flagship program — adults 16 and up, beginners fully expected. Most people walk in with zero experience and start with the fundamentals.
      </p>
      <p class="text-brand-gray leading-relaxed mb-4">
        Plenty of schools in the area teach BJJ; a few even share our lineage. The difference is the coach. Jamal's competition record — ADCC, IFL, Bellator, UWC Light Heavyweight Champion — informs every position and transition he teaches. See the full <a href="/adult-bjj/" class="text-brand-navy font-bold hover:text-brand-gold transition-colors">adult BJJ</a> program.
      </p>
      <p class="text-brand-gray leading-relaxed">
        Evening classes at 6, 7, and 8 PM most weekdays, built around working adults who commute. Two weeks free, no contract.
      </p>
    </div>
  </section>

  <!-- Kids -->
  <section class="section-pad bg-brand-gray-light">
    <div class="container-page max-w-3xl">
      <div class="eyebrow">Kids Martial Arts</div>
      <h2 class="text-3xl md:text-4xl text-brand-black mb-5">Kids Martial Arts for Scotch Plains Families</h2>
      <div class="space-y-5">
        <div class="bg-white p-6 rounded-lg border-l-4 border-brand-gold">
          <h3 class="text-xl text-brand-black mb-2">Cubs — Ages 4–6</h3>
          <p class="text-brand-gray text-sm leading-relaxed">Preschool-age energy given some structure. Coordination, listening, and confidence come first, delivered in short, high-engagement bursts with steady positive reinforcement.</p>
        </div>
        <div class="bg-white p-6 rounded-lg border-l-4 border-brand-navy">
          <h3 class="text-xl text-brand-black mb-2">Lions — Ages 7–13</h3>
          <p class="text-brand-gray text-sm leading-relaxed">Real Brazilian Jiu-Jitsu — takedowns, escapes, positions. Not katas; a working system with a real belt progression. Parents consistently tell us the confidence and focus carry off the mat and into school.</p>
        </div>
      </div>
      <p class="text-brand-gray leading-relaxed mt-5">
        Bully prevention is a real part of what we teach. Once a kid knows they can handle themselves, the dynamic with a bully tends to shift — usually without a single punch thrown. Take a look at the <a href="/kids/" class="text-brand-navy font-bold hover:text-brand-gold transition-colors">kids program</a>.
      </p>
    </div>
  </section>

  <!-- Muay Thai + MMA -->
  <section class="section-pad bg-brand-navy text-white">
    <div class="container-page max-w-4xl">
      <div class="grid md:grid-cols-2 gap-8">
        <div>
          <div class="eyebrow text-brand-gold">Muay Thai</div>
          <h2 class="text-2xl md:text-3xl mb-4">Muay Thai Near Scotch Plains, NJ</h2>
          <p class="text-white/90 leading-relaxed">
            Authentic Muay Thai under the same roof as your BJJ — real pad work, technique, and conditioning, not cardio kickboxing. Adults 16 and up, and beginners are welcome from day one.
          </p>
        </div>
        <div>
          <div class="eyebrow text-brand-gold">MMA</div>
          <h2 class="text-2xl md:text-3xl mb-4">MMA Near Scotch Plains, NJ</h2>
          <p class="text-white/90 leading-relaxed">
            Our MMA program combines Brazilian Jiu-Jitsu, Muay Thai, and wrestling into one system, coached by Jamal Patterson — a pro MMA fighter who has cornered UFC fighters. Adults 16 and up, all levels.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Landmarks -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-3xl">
      <div class="eyebrow">If you know Scotch Plains</div>
      <h2 class="text-2xl md:text-3xl text-brand-black mb-5">You Know These Spots — We're 12 Minutes Away</h2>
      <div class="flex flex-wrap gap-2">
        {["Downtown Scotch Plains", "Scotch Plains Public Library", "Fanwood border", "Route 22 corridor", "Green Brook Park", "Scotch Plains High School", "Park Middle School", "Scotch Plains Municipal Pool"].map((l) => (
          <span class="bg-brand-gray-light text-brand-gray px-4 py-2 rounded-full text-sm">📍 {l}</span>
        ))}
      </div>
    </div>
  </section>

  <FAQ items={faqs} />

  <CTA
    headline="Two Weeks Free — Scotch Plains Families Welcome"
    sub="Show up. Bring water. We'll handle the rest. No commitment, no pressure."
  />
</PageLayout>
