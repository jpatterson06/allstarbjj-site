---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
import FAQ from '../components/FAQ.astro';
import FAQPageSchema from '../components/FAQPageSchema.astro';
import LocalBusinessSchema from '../components/LocalBusinessSchema.astro';
import CTA from '../components/CTA.astro';

const faqs = [
  { q: "How far is AllStar from Springfield?", a: "About 10 minutes via Route 22 east. 1166 West Chestnut St, Union, NJ 07083. Free parking." },
  { q: "What programs are available for Springfield families?", a: "Adult BJJ, Muay Thai, and MMA (16+). Kids Lions (7–13) and Cubs (4–6). Seasonal summer camp." },
  { q: "Can my child start with no martial arts background?", a: "Yes. The kids curriculum starts from zero. White belt, lesson one." },
  { q: "Is there Muay Thai instruction near Springfield?", a: "AllStar is the closest option offering authentic Muay Thai instruction in the area — real pad work, not cardio kickboxing." },
  { q: "What's the trial?", a: "Two weeks of unlimited classes. Free. No card required. No contract." },
  { q: "How do I get started?", a: "Fill out the form or call (908) 341-1131. We'll text you to set up a time." },
];
---

<PageLayout
  title="Martial Arts in Springfield, NJ — BJJ, Muay Thai & Kids Classes | AllStar"
  description="Martial arts classes for Springfield, NJ families at AllStar Martial Arts in Union. BJJ, Muay Thai, MMA, and Kids programs. Renzo Gracie black belt. Claim your spot today."
  ogImage="/images/adult-bjj-hero.jpg"
>
  <Fragment slot="head">
    <LocalBusinessSchema city="Springfield" />
    <FAQPageSchema faqs={faqs} />
  </Fragment>

  <PageHero
    eyebrow="10 minutes on Route 22"
    headline="Martial Arts in Springfield, NJ"
    sub="Brazilian Jiu-Jitsu, Muay Thai, MMA, and Kids programs — barely 10 minutes east on Route 22. Claim your spot today, no contract."
    bgImage="/images/adult-bjj-hero.jpg"
  />

  <!-- Intro -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-3xl">
      <p class="text-lg md:text-xl text-brand-gray leading-relaxed mb-6">
        Springfield and Union share a border, and Route 22 stitches them together in about 10 minutes — often less, depending on whether you're coming off Morris Ave or down Mountain Ave. AllStar Martial Arts is parked right on the Union side of that line, which makes us less a destination and more a natural extension of your own neighborhood. Springfield sits between us, <a href="/millburn/" class="text-brand-navy font-bold hover:text-brand-gold transition-colors">Millburn →</a>, and <a href="/mountainside/" class="text-brand-navy font-bold hover:text-brand-gold transition-colors">Mountainside →</a>.
      </p>
      <p class="text-lg md:text-xl text-brand-gray leading-relaxed">
        Springfield families have trained here for years, and the loyalty tells the story: kids who joined the Lions program as tiny white belts are now grown members in the adult class, and adults who wandered in on a friend's Tuesday-night nudge have shown up twice a week for a decade since. That's what a room built on real instruction and a real culture does — people don't leave.
      </p>
    </div>
  </section>

  <!-- BJJ -->
  <section class="section-pad bg-brand-gray-light">
    <div class="container-page max-w-3xl">
      <div class="eyebrow">Brazilian Jiu-Jitsu</div>
      <h2 class="text-3xl md:text-4xl text-brand-black mb-5">BJJ Near Springfield, NJ</h2>
      <p class="text-brand-gray leading-relaxed mb-4">
        Coach Jamal Patterson trained directly under Renzo Gracie in New York. He's an ADCC veteran who fought professionally in the IFL, Bellator, and UWC — where he took the light heavyweight title. That competition résumé isn't decoration on a wall; it's the reason the details are taught the way they are.
      </p>
      <p class="text-brand-gray leading-relaxed">
        Most instructors picked up the art recreationally. Jamal's game was pressure-tested against professionals, and Springfield students who've trained elsewhere first are usually the quickest to point out the difference in depth. <a href="/adult-bjj/" class="text-brand-navy font-bold hover:text-brand-gold transition-colors">Adult BJJ →</a> at AllStar runs ages 16 and up, beginners welcome, with evening classes timed for the drive home from work.
      </p>
    </div>
  </section>

  <!-- Kids -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-3xl">
      <div class="eyebrow">Kids Programs</div>
      <h2 class="text-3xl md:text-4xl text-brand-black mb-5">Kids Martial Arts in Springfield, NJ</h2>
      <p class="text-brand-gray leading-relaxed mb-5">
        The kids program is built around real Brazilian Jiu-Jitsu — not karate, not Taekwondo, not cardio-kickboxing dressed up for children. This is the art Helio Gracie engineered so a smaller person could control a bigger one through leverage and technique rather than force.
      </p>
      <div class="space-y-5">
        <div class="bg-brand-gray-light p-6 rounded-lg border-l-4 border-brand-gold">
          <h3 class="text-xl text-brand-black mb-2">Cubs — Ages 4–6</h3>
          <p class="text-brand-gray text-sm leading-relaxed">Preschool energy given martial arts structure. Heavy emphasis on listening, coordination, and the quiet confidence that comes from learning to move well.</p>
        </div>
        <div class="bg-brand-gray-light p-6 rounded-lg border-l-4 border-brand-navy">
          <h3 class="text-xl text-brand-black mb-2">Lions — Ages 7–13</h3>
          <p class="text-brand-gray text-sm leading-relaxed">Real technique, a progressive curriculum, and a stripe-and-belt system that keeps kids honest. Springfield parents tell us their kids' teachers notice sharper focus and steadier composure by around October of the school year.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Muay Thai + MMA -->
  <section class="section-pad bg-brand-navy text-white">
    <div class="container-page max-w-4xl">
      <div class="grid md:grid-cols-2 gap-8">
        <div>
          <div class="eyebrow text-brand-gold">Muay Thai</div>
          <h2 class="text-2xl md:text-3xl mb-4">Only Authentic Muay Thai in the Area</h2>
          <p class="text-white/90 leading-relaxed">
            Springfield doesn't have a Muay Thai gym. Most of Union County doesn't either. AllStar is the closest school running authentic <a href="/adult-muay-thai/" class="text-brand-navy font-bold hover:text-brand-gold transition-colors">Muay Thai →</a> alongside its jiu-jitsu — genuine pad work, real coaching, and adults of every fitness level on the same floor.
          </p>
        </div>
        <div>
          <div class="eyebrow text-brand-gold">MMA</div>
          <h2 class="text-2xl md:text-3xl mb-4">MMA Near Springfield, NJ</h2>
          <p class="text-white/90 leading-relaxed">
            Our MMA program braids BJJ, Muay Thai, and wrestling into one system, coached by Jamal Patterson — pro fighter, IFL and Bellator veteran. Adults 16 and up. It isn't recreational drop-in; it's structured, progressive, professional-level instruction.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Landmarks -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-3xl">
      <div class="eyebrow">If you know Springfield</div>
      <h2 class="text-2xl md:text-3xl text-brand-black mb-5">10 Minutes via Route 22 East</h2>
      <div class="flex flex-wrap gap-2">
        {["Springfield Mall", "Jonathan Dayton High School", "Caldwell Elementary", "Sandmeier School", "Walton School", "Gaudineer School", "Mountain Ave", "Morris Ave", "Springfield Library"].map((l) => (
          <span class="bg-brand-gray-light text-brand-gray px-4 py-2 rounded-full text-sm">📍 {l}</span>
        ))}
      </div>
    </div>
  </section>

  <FAQ items={faqs} />

  <CTA
    headline="Two Weeks Free — Springfield Families Welcome"
    sub="Show up. Bring water. We'll handle the rest. No commitment, no pressure."
  />
</PageLayout>
