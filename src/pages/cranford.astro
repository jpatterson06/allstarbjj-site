---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
import FAQ from '../components/FAQ.astro';
import FAQPageSchema from '../components/FAQPageSchema.astro';
import LocalBusinessSchema from '../components/LocalBusinessSchema.astro';
import CTA from '../components/CTA.astro';

const city = "Cranford";

const faqs = [
  { q: "How far is AllStar from Cranford?", a: "About 10 minutes via the Garden State Parkway. 1166 West Chestnut St, Union. Free parking on-site." },
  { q: "What programs are available?", a: "Adult BJJ, Muay Thai, and MMA (ages 16+). Kids Lions (7–13) and Cubs (4–6). Summer camp runs seasonally." },
  { q: "Do I need experience?", a: "No. Most students — adults and kids — start with none." },
  { q: "Can I watch a class before enrolling my child?", a: "Yes. Walk in any time. We don't hide what we do." },
  { q: "What's the free trial?", a: "Two weeks of unlimited classes. Adults can try any program. Kids can try their age group. No card required, no contract, no pressure." },
  { q: "How do I start?", a: "Fill out the form on this page or call (908) 341-1131. We'll text to confirm a class time." },
];
---

<PageLayout
  title="Martial Arts in Cranford, NJ — BJJ, Muay Thai & Kids Classes | AllStar"
  description="Martial arts classes for Cranford, NJ families at AllStar Martial Arts in Union. BJJ, Muay Thai, MMA, and Kids programs. Renzo Gracie black belt. Free 2-week trial."
  ogImage="/images/adult-bjj-hero.jpg"
>
  <Fragment slot="head">
    <LocalBusinessSchema city={city} />
    <FAQPageSchema faqs={faqs} />
  </Fragment>

  <PageHero
    eyebrow="10 minutes from Cranford"
    headline="Martial Arts in Cranford, NJ"
    sub="Brazilian Jiu-Jitsu, Muay Thai, MMA, and Kids programs — about 10 minutes up the Garden State Parkway from downtown Cranford. Free 2-week trial, no contract."
    bgImage="/images/adult-bjj-hero.jpg"
  />

  <!-- Intro -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-3xl">
      <p class="text-lg md:text-xl text-brand-gray leading-relaxed mb-6">
        Cranford is a walkable, train-town kind of place — the Raritan Valley Line pulling in beside a downtown that empties out along the Rahway River and Nomahegan Park. AllStar has been part of the routine for Cranford families for over a decade: roughly 10 minutes up the Garden State Parkway from the center of town, door to mat, with free parking waiting. Neighbors in <a href="/garwood/" class="text-brand-navy font-bold hover:text-brand-gold transition-colors">Garwood</a> and <a href="/westfield/" class="text-brand-navy font-bold hover:text-brand-gold transition-colors">Westfield</a> share the drive.
      </p>
      <p class="text-lg md:text-xl text-brand-gray leading-relaxed">
        The pull is the coaching. Coach Jamal Patterson is a Renzo Gracie black belt, ADCC veteran, and former professional MMA fighter who fought in the IFL and Bellator. That competition background changes how technique is broken down — and students who've trained here for five and ten years will tell you the difference shows up the moment you roll.
      </p>
    </div>
  </section>

  <!-- BJJ -->
  <section class="section-pad bg-brand-gray-light">
    <div class="container-page max-w-3xl">
      <div class="eyebrow">Brazilian Jiu-Jitsu</div>
      <h2 class="text-3xl md:text-4xl text-brand-black mb-5">BJJ Classes Near Cranford, NJ</h2>
      <p class="text-brand-gray leading-relaxed mb-4">
        Brazilian Jiu-Jitsu is our flagship program. Adults 16 and up, beginners fully expected — most people walk in with zero experience.
      </p>
      <p class="text-brand-gray leading-relaxed mb-4">
        Plenty of schools in the area teach BJJ, and a few even share our lineage. The difference is the coach. Jamal's competition resume — ADCC, IFL, Bellator, UWC champion — isn't a plaque on the wall; it informs every grip and every transition he teaches. See the full <a href="/adult-bjj/" class="text-brand-navy font-bold hover:text-brand-gold transition-colors">adult BJJ</a> program.
      </p>
      <p class="text-brand-gray leading-relaxed">
        Evening classes at 6, 7, and 8 PM most weekdays — built around Raritan Valley Line schedules and working adults who commute. Two weeks free. No contract.
      </p>
    </div>
  </section>

  <!-- Kids -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-3xl">
      <div class="eyebrow">Kids Martial Arts</div>
      <h2 class="text-3xl md:text-4xl text-brand-black mb-5">Kids Martial Arts Near Cranford, NJ</h2>
      <div class="space-y-5">
        <div class="bg-brand-gray-light p-6 rounded-lg border-l-4 border-brand-gold">
          <h3 class="text-xl text-brand-black mb-2">Cubs — Ages 4–6</h3>
          <p class="text-brand-gray text-sm leading-relaxed">Preschool-age energy given some structure. Coordination, listening, and confidence come first, delivered in short, high-engagement bursts with steady positive reinforcement.</p>
        </div>
        <div class="bg-brand-gray-light p-6 rounded-lg border-l-4 border-brand-navy">
          <h3 class="text-xl text-brand-black mb-2">Lions — Ages 7–13</h3>
          <p class="text-brand-gray text-sm leading-relaxed">Real Brazilian Jiu-Jitsu — takedowns, escapes, positions. These aren't karate katas; they're a working system, and Cranford parents keep reporting that the confidence carries from the mat straight into the halls at Cranford High.</p>
        </div>
      </div>
      <p class="text-brand-gray leading-relaxed mt-5">
        Bully prevention is a real part of what we teach. Once a kid knows they can handle themselves, the dynamic with a bully shifts — usually without a single punch thrown. Take a look at the <a href="/kids/" class="text-brand-navy font-bold hover:text-brand-gold transition-colors">kids program</a>.
      </p>
    </div>
  </section>

  <!-- Muay Thai + MMA -->
  <section class="section-pad bg-brand-navy text-white">
    <div class="container-page max-w-4xl">
      <div class="grid md:grid-cols-2 gap-8">
        <div>
          <div class="eyebrow text-brand-gold">Muay Thai</div>
          <h2 class="text-2xl md:text-3xl mb-4">Muay Thai Near Cranford, NJ</h2>
          <p class="text-white/90 leading-relaxed">
            This is the one nobody else in Union County pairs with BJJ. No gym in the Cranford, Union, or Westfield area offers authentic Muay Thai instruction under the same roof. Real pad work, real technique, real conditioning — and beginners are welcome from day one.
          </p>
        </div>
        <div>
          <div class="eyebrow text-brand-gold">MMA</div>
          <h2 class="text-2xl md:text-3xl mb-4">MMA Classes Near Cranford, NJ</h2>
          <p class="text-white/90 leading-relaxed">
            Our MMA program puts BJJ, Muay Thai, and wrestling together into one complete system. Coached by Jamal Patterson — a pro MMA fighter who has cornered UFC athletes from their amateur debut to the pros. Adults 16 and up.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Landmarks -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-3xl">
      <div class="eyebrow">If you know Cranford</div>
      <h2 class="text-2xl md:text-3xl text-brand-black mb-5">You Know These Spots — We're 10 Minutes Away</h2>
      <div class="flex flex-wrap gap-2">
        {["Downtown Cranford", "Nomahegan Park", "Cranford Train Station", "Rahway River Parkway", "Cranford Municipal Pool", "Orange Ave", "Cranford High School", "Lincoln Elementary"].map((l) => (
          <span class="bg-brand-gray-light text-brand-gray px-4 py-2 rounded-full text-sm">📍 {l}</span>
        ))}
      </div>
    </div>
  </section>

  <FAQ items={faqs} />

  <CTA
    headline="Two Weeks Free — Cranford Families Welcome"
    sub="Show up. Bring water. We'll handle the rest. No commitment, no pressure."
  />
</PageLayout>
