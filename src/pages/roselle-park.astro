---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
import FAQ from '../components/FAQ.astro';
import FAQPageSchema from '../components/FAQPageSchema.astro';
import LocalBusinessSchema from '../components/LocalBusinessSchema.astro';
import CTA from '../components/CTA.astro';

const city = "Roselle Park";

const faqs = [
  { q: "How far is AllStar from Roselle Park?", a: "Under 10 minutes. We share a border with Union. 1166 West Chestnut St, Union, NJ 07083." },
  { q: "Can siblings join different programs?", a: "Yes — Cubs and Lions run at the same location. Many Roselle Park families have kids in both." },
  { q: "Do I need experience as an adult?", a: "No. Most students walk in untrained. We have a structured beginner curriculum." },
  { q: "Free trial?", a: "Two weeks unlimited. No card, no contract." },
  { q: "How do I start?", a: "Fill out the form or call (908) 341-1131." },
];
---

<PageLayout
  title="Martial Arts in Roselle Park, NJ — BJJ, Muay Thai & Kids | AllStar"
  description="Martial arts classes for Roselle Park, NJ families at AllStar Martial Arts in Union. BJJ, Muay Thai, MMA, and Kids programs. Renzo Gracie black belt. Free 2-week trial."
  ogImage="/images/adult-bjj-hero.jpg"
>
  <Fragment slot="head">
    <LocalBusinessSchema city={city} />
    <FAQPageSchema faqs={faqs} />
  </Fragment>

  <PageHero
    eyebrow="6 minutes from Roselle Park"
    headline="Martial Arts in Roselle Park, NJ"
    sub="Brazilian Jiu-Jitsu, Muay Thai, MMA, and Kids programs — about 6 minutes from Roselle Park, down Westfield Avenue into Union. Free 2-week trial, no contract."
    bgImage="/images/adult-bjj-hero.jpg"
  />

  <!-- Intro — accurate description of AllStar + the Roselle Park connection (verified facts only) -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-3xl">
      <p class="text-lg md:text-xl text-brand-gray leading-relaxed mb-6">
        AllStar Martial Arts is a family-owned Brazilian Jiu-Jitsu, Muay Thai, and MMA school at 1166 West Chestnut St in Union, NJ — about <strong>6 minutes from Roselle Park</strong>, down Westfield Avenue, with free parking on-site. We've taught adults and kids here since 2011.
      </p>
      <p class="text-lg md:text-xl text-brand-gray leading-relaxed mb-6">
        Head coach Jamal Patterson is a 4th-degree Brazilian Jiu-Jitsu black belt under Renzo Gracie, an ADCC veteran, and a former professional MMA fighter with wins in the IFL and Bellator. That competition background is what sets AllStar apart from the fitness-boxing and add-on BJJ classes around Roselle Park.
      </p>
      <p class="text-lg md:text-xl text-brand-gray leading-relaxed">
        Adults train BJJ, Muay Thai, kickboxing, and MMA (ages 16+); kids have Cubs (4–6) and Lions (7–13). Every new student starts with a free two-week trial — no contract, no card. Neighbors in <a href="/cranford/" class="text-brand-navy font-bold hover:text-brand-gold transition-colors">Cranford</a> and <a href="/kenilworth/" class="text-brand-navy font-bold hover:text-brand-gold transition-colors">Kenilworth</a> make the same short drive.
      </p>
    </div>
  </section>

  <!-- Google Business location embedded — directions from Roselle Park to the gym -->
  <section class="section-pad bg-brand-gray-light">
    <div class="container-page max-w-4xl">
      <div class="text-center mb-6">
        <div class="eyebrow">Find us from Roselle Park</div>
        <h2 class="text-2xl md:text-3xl text-brand-black">6 Minutes Down Westfield Avenue</h2>
      </div>
      <iframe
        title="Directions from Roselle Park, NJ to AllStar Martial Arts, 1166 West Chestnut St, Union, NJ"
        src="https://maps.google.com/maps?saddr=Roselle+Park,+NJ&amp;daddr=1166+West+Chestnut+St,+Union,+NJ+07083&amp;output=embed"
        class="w-full h-72 md:h-80 rounded-lg border-0"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
      <p class="text-center mt-4 text-brand-gray">
        1166 West Chestnut St, Union, NJ 07083 · <a href="https://maps.app.goo.gl/cBJKvZMvtEjfTgNY9" target="_blank" rel="noopener" class="text-brand-navy font-bold hover:text-brand-gold transition-colors">View AllStar on Google Maps →</a>
      </p>
    </div>
  </section>

  <!-- BJJ -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-3xl">
      <div class="eyebrow">Brazilian Jiu-Jitsu</div>
      <h2 class="text-3xl md:text-4xl text-brand-black mb-5">BJJ Classes for Roselle Park Adults</h2>
      <p class="text-brand-gray leading-relaxed mb-4">
        Brazilian Jiu-Jitsu is our flagship program — adults 16 and up, beginners fully expected. Most people walk in with zero experience and start with the fundamentals.
      </p>
      <p class="text-brand-gray leading-relaxed mb-4">
        Plenty of schools in the area teach BJJ; a few even share our lineage. The difference is the coach. Jamal's competition record — ADCC, IFL, Bellator, UWC Light Heavyweight Champion — informs every position and transition he teaches. See the full <a href="/adult-bjj/" class="text-brand-navy font-bold hover:text-brand-gold transition-colors">adult BJJ</a> program.
      </p>
      <p class="text-brand-gray leading-relaxed">
        Evening classes at 6, 7, and 8 PM most weekdays, built around working adults who commute. Two weeks free, no contract.
      </p>
    </div>
  </section>

  <!-- Kids -->
  <section class="section-pad bg-brand-gray-light">
    <div class="container-page max-w-3xl">
      <div class="eyebrow">Kids Martial Arts</div>
      <h2 class="text-3xl md:text-4xl text-brand-black mb-5">Kids Martial Arts for Roselle Park Families</h2>
      <div class="space-y-5">
        <div class="bg-white p-6 rounded-lg border-l-4 border-brand-gold">
          <h3 class="text-xl text-brand-black mb-2">Cubs — Ages 4–6</h3>
          <p class="text-brand-gray text-sm leading-relaxed">Preschool-age energy given some structure. Coordination, listening, and confidence come first, delivered in short, high-engagement bursts with steady positive reinforcement.</p>
        </div>
        <div class="bg-white p-6 rounded-lg border-l-4 border-brand-navy">
          <h3 class="text-xl text-brand-black mb-2">Lions — Ages 7–13</h3>
          <p class="text-brand-gray text-sm leading-relaxed">Real Brazilian Jiu-Jitsu — takedowns, escapes, positions. Not katas; a working system with a real belt progression. Parents consistently tell us the confidence and focus carry off the mat and into school.</p>
        </div>
      </div>
      <p class="text-brand-gray leading-relaxed mt-5">
        Bully prevention is a real part of what we teach. Once a kid knows they can handle themselves, the dynamic with a bully tends to shift — usually without a single punch thrown. Take a look at the <a href="/kids/" class="text-brand-navy font-bold hover:text-brand-gold transition-colors">kids program</a>.
      </p>
    </div>
  </section>

  <!-- Muay Thai + MMA -->
  <section class="section-pad bg-brand-navy text-white">
    <div class="container-page max-w-4xl">
      <div class="grid md:grid-cols-2 gap-8">
        <div>
          <div class="eyebrow text-brand-gold">Muay Thai</div>
          <h2 class="text-2xl md:text-3xl mb-4">Muay Thai Near Roselle Park, NJ</h2>
          <p class="text-white/90 leading-relaxed">
            Authentic Muay Thai under the same roof as your BJJ — real pad work, technique, and conditioning, not cardio kickboxing. Adults 16 and up, and beginners are welcome from day one.
          </p>
        </div>
        <div>
          <div class="eyebrow text-brand-gold">MMA</div>
          <h2 class="text-2xl md:text-3xl mb-4">MMA Near Roselle Park, NJ</h2>
          <p class="text-white/90 leading-relaxed">
            Our MMA program combines Brazilian Jiu-Jitsu, Muay Thai, and wrestling into one system, coached by Jamal Patterson — a pro MMA fighter who has cornered UFC fighters. Adults 16 and up, all levels.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Landmarks -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-3xl">
      <div class="eyebrow">If you know Roselle Park</div>
      <h2 class="text-2xl md:text-3xl text-brand-black mb-5">You Know These Spots — We're 6 Minutes Away</h2>
      <div class="flex flex-wrap gap-2">
        {["Casano Community Center", "Roselle Park Train Station", "Westfield Avenue", "Veterans Memorial Park"].map((l) => (
          <span class="bg-brand-gray-light text-brand-gray px-4 py-2 rounded-full text-sm">📍 {l}</span>
        ))}
      </div>
    </div>
  </section>

  <FAQ items={faqs} />

  <CTA
    headline="Two Weeks Free — Roselle Park Families Welcome"
    sub="Show up. Bring water. We'll handle the rest. No commitment, no pressure."
  />
</PageLayout>
