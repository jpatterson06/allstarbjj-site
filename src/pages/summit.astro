---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import FAQPageSchema from '../components/FAQPageSchema.astro';
import LocalBusinessSchema from '../components/LocalBusinessSchema.astro';

const faqs = [
  { q: "How far is AllStar from Summit?", a: "About 20 minutes via Route 22 east. 1166 West Chestnut St, Union, NJ 07083." },
  { q: "Is there Muay Thai near Summit?", a: "AllStar is the closest authentic Muay Thai option to Summit — real pad work and clinch, not a cardio class." },
  { q: "Evening classes available?", a: "Yes — 6, 7, and 8 PM most weekdays, timed for the Midtown Direct crowd getting back to Summit station. Saturday mornings for adults and kids." },
  { q: "Free trial?", a: "Two weeks unlimited. No card, no contract." },
  { q: "How do I start?", a: "Fill out the form or call (908) 341-1131." },
];

const city = "Summit";
---

<Fragment slot="head">
    <LocalBusinessSchema city={city} />
    <FAQPageSchema faqs={faqs} />
  </Fragment>

  <PageLayout
  title="Martial Arts in Summit, NJ — BJJ, Muay Thai & Kids Classes | AllStar"
  description="Martial arts classes for Summit, NJ families at AllStar Martial Arts in Union. BJJ, Muay Thai, MMA, and Kids programs. Renzo Gracie black belt. Free 2-week trial."
  ogImage="/images/adult-bjj-hero.jpg"
>
  <PageHero
    eyebrow="20 Minutes from Summit"
    headline="Martial Arts in Summit, NJ"
    sub="Brazilian Jiu-Jitsu, Muay Thai, MMA, and Kids programs — about 20 minutes down Route 22. Taught by a Renzo Gracie black belt. Free 2-week trial, no contract."
    bgImage="/images/adult-bjj-hero.jpg"
  />

  <!-- Intro -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-3xl">
      <p class="text-lg md:text-xl text-brand-gray leading-relaxed mb-5">
        Summit is a town that catches the Midtown Direct in the morning and expects the good version of everything by the time it gets home. Martial arts is one of the few things you can't find at the top of the hill — there's no authentic Muay Thai room downtown, and no black-belt-run BJJ program between the arboretum and the station. AllStar Martial Arts sits about 20 minutes away on Route 22 in Union, and Summit families keep making that drive because what's waiting is the most credentialed coaching in Union County.
      </p>
      <p class="text-lg md:text-xl text-brand-gray leading-relaxed">
        Coach Jamal Patterson — Renzo Gracie black belt, ADCC veteran, IFL and Bellator pro fighter, UWC light heavyweight champion — has been running the gym as a family business since 2011. If you're weighing the trip, the honest first step is the free <a href="/trial/" class="text-brand-navy font-bold hover:text-brand-gold transition-colors">two-week trial →</a> — no card, nothing to cancel.
      </p>
    </div>
  </section>

  <!-- Programs -->
  <section class="section-pad bg-brand-gray-light">
    <div class="container-page max-w-4xl">
      <div class="grid md:grid-cols-2 gap-10">
        <div>
          <div class="eyebrow">Adults</div>
          <h2 class="text-2xl md:text-3xl text-brand-black mb-4">BJJ for Summit Adults</h2>
          <p class="text-brand-gray leading-relaxed">
            Adult Brazilian Jiu-Jitsu, ages 16 and up, beginners first. The Renzo Gracie lineage is unbroken: Helio to Carlos to Rolls to Renzo to Jamal. Evening classes at 6, 7, and 8 PM are built for the commute — get off the train at Summit, and there's still time to train. Plenty of our Summit regulars first tried something closer to home; most of them tell us it simply wasn't the same room. Neighboring <a href="/new-providence/" class="text-brand-navy font-bold hover:text-brand-gold transition-colors">New Providence families →</a> make the same drive.
          </p>
        </div>
        <div>
          <div class="eyebrow">Muay Thai + MMA</div>
          <h2 class="text-2xl md:text-3xl text-brand-black mb-4">Muay Thai & MMA Near Summit</h2>
          <p class="text-brand-gray leading-relaxed">
            The Summit–New Providence–Chatham corridor has no genuine Muay Thai program, and AllStar is the closest one going. Our adults stack <a href="/adult-muay-thai/" class="text-brand-navy font-bold hover:text-brand-gold transition-colors">Muay Thai →</a> on top of their jiu-jitsu — striking and grappling in one membership — which is about as complete as martial arts gets around here. Adult MMA is coached directly by Jamal Patterson.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Kids -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-3xl">
      <div class="eyebrow">Kids Martial Arts</div>
      <h2 class="text-3xl md:text-4xl text-brand-black mb-6">Kids Martial Arts for Summit Families</h2>
      <div class="space-y-5">
        <div class="bg-brand-gray-light p-6 rounded-lg border-l-4 border-brand-gold">
          <h3 class="text-xl text-brand-black mb-2">Cubs — Ages 4–6</h3>
          <p class="text-brand-gray text-sm leading-relaxed">Coordination, listening, and confidence in 30 focused minutes built for preschool attention spans. Summit parents — the same ones who obsess over the right elementary placement — keep telling us the listening shows up in the classroom within a few weeks.</p>
        </div>
        <div class="bg-brand-gray-light p-6 rounded-lg border-l-4 border-brand-navy">
          <h3 class="text-xl text-brand-black mb-2">Lions — Ages 7–13</h3>
          <p class="text-brand-gray text-sm leading-relaxed">Real Brazilian Jiu-Jitsu on a progressive belt system. Summit kids who make the trip tend to be the motivated ones — they thrive on a genuine challenge, and the drive itself becomes part of the commitment. Read more about our <a href="/kids/" class="text-brand-navy font-bold hover:text-brand-gold transition-colors">kids program →</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Landmarks -->
  <section class="section-pad bg-brand-navy text-white">
    <div class="container-page max-w-3xl">
      <div class="eyebrow text-brand-gold">If you know Summit</div>
      <h2 class="text-2xl md:text-3xl mb-5">You Know These Spots — We're 20 Minutes Away</h2>
      <div class="flex flex-wrap gap-2">
        {["Downtown Summit", "Summit Train Station", "Brayton Elementary", "Jefferson Elementary", "Summit High School", "Reeves-Reed Arboretum", "Memorial Field", "DeForest Ave"].map((l) => (
          <span class="bg-white/10 text-white/90 px-4 py-2 rounded-full text-sm">📍 {l}</span>
        ))}
      </div>
      <p class="text-white/80 mt-5 text-sm">About 20 minutes via Route 22. Free parking on-site at AllStar.</p>
    </div>
  </section>

  <FAQ items={faqs} />

  <CTA
    headline="Two Weeks Free — Summit Families Welcome"
    sub="Show up. Bring water. We'll handle the rest. No commitment, no pressure."
  />
</PageLayout>
