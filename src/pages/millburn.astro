---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import FAQPageSchema from '../components/FAQPageSchema.astro';
import LocalBusinessSchema from '../components/LocalBusinessSchema.astro';

const faqs = [
  { q: "How far is AllStar from Millburn?", a: "About 12–15 minutes via Route 22 west to Union. 1166 West Chestnut St, Union, NJ 07083. Free parking." },
  { q: "Is there any Muay Thai near Millburn?", a: "AllStar is the closest authentic Muay Thai program to Millburn and Short Hills." },
  { q: "Do kids need to be athletic to start?", a: "No. The curriculum starts from zero. Coordination and fitness build as part of training." },
  { q: "Can adults try BJJ and Muay Thai at the same time?", a: "Yes — many Millburn members train both. They work well together." },
  { q: "What's included in the free trial?", a: "Two full weeks of unlimited classes. No card, no contract, no obligation." },
  { q: "How do I enroll?", a: "Fill out the form on this page or call (908) 341-1131. We'll respond same day." },
];

const city = "Millburn";
---

<Fragment slot="head">
    <LocalBusinessSchema city={city} />
    <FAQPageSchema faqs={faqs} />
  </Fragment>

  <PageLayout
  title="Martial Arts in Millburn, NJ — BJJ, Muay Thai & Kids Classes | AllStar"
  description="Martial arts classes for Millburn and Short Hills families at AllStar Martial Arts in Union. BJJ, Muay Thai, MMA, and Kids programs. Renzo Gracie black belt. Free 2-week trial."
  ogImage="/images/adult-bjj-hero.jpg"
>
  <PageHero
    eyebrow="15 minutes from Millburn"
    headline="Martial Arts in Millburn, NJ"
    sub="Worth the drive. Every time. BJJ, Muay Thai, MMA, and Kids programs for Millburn and Short Hills families. Free 2-week trial — no contract."
    bgImage="/images/adult-bjj-hero.jpg"
  />

  <!-- Intro -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-3xl">
      <p class="text-lg md:text-xl text-brand-gray leading-relaxed mb-6">
        Millburn and Short Hills families are used to going a little farther for quality. You drive to a better restaurant, a better school program, a better anything — because you've learned that the closest option and the best option aren't always the same address.
      </p>
      <p class="text-lg md:text-xl text-brand-gray leading-relaxed">
        AllStar Martial Arts is about 15 minutes from Millburn on Route 22 west into Union. The drive is easy. The parking is free. And what's on the other side is the best martial arts instruction in Union County — by coaching background, by program breadth, by community. Coach Jamal Patterson is a Renzo Gracie black belt, ADCC veteran, and former professional MMA fighter who has been coaching in Union since 2011.
      </p>
    </div>
  </section>

  <!-- BJJ -->
  <section class="section-pad bg-brand-gray-light">
    <div class="container-page max-w-3xl">
      <div class="eyebrow">Brazilian Jiu-Jitsu</div>
      <h2 class="text-3xl md:text-4xl text-brand-black mb-5">BJJ Classes for Millburn & Short Hills Adults</h2>
      <p class="text-brand-gray leading-relaxed mb-4">
        Brazilian Jiu-Jitsu is our main adult program. Ages 16 and up. No experience needed.
      </p>
      <p class="text-brand-gray leading-relaxed mb-4">
        Millburn adults who join AllStar often describe the same arc: they thought about starting for a long time. They drove past closer options and weren't convinced. They tried AllStar on a free trial and realized immediately it was different.
      </p>
      <p class="text-brand-gray leading-relaxed">
        The difference is in how technique is taught when the person teaching it has actually competed. Jamal's instruction is built on techniques that were tested in professional fights. Evening classes at 6, 7, and 8 PM most weekdays. Saturday mornings. Built for Millburn and Short Hills commuters on NJ Transit.
      </p>
    </div>
  </section>

  <!-- Kids -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-3xl">
      <div class="eyebrow">Kids Programs</div>
      <h2 class="text-3xl md:text-4xl text-brand-black mb-5">Kids Martial Arts for Millburn Families</h2>
      <p class="text-brand-gray leading-relaxed mb-5">
        Millburn Township has excellent schools and high expectations for extracurriculars. The kids who thrive at AllStar are often exactly the kind of kids Millburn families raise — sharp, competitive, responsive to real challenge.
      </p>
      <div class="space-y-5">
        <div class="bg-brand-gray-light p-6 rounded-lg border-l-4 border-brand-gold">
          <h3 class="text-xl text-brand-black mb-2">Cubs — Ages 4–6</h3>
          <p class="text-brand-gray text-sm leading-relaxed">Preschool martial arts. Big energy, short activities, constant positive reinforcement. Parents consistently report that the listening carries over at home and at school.</p>
        </div>
        <div class="bg-brand-gray-light p-6 rounded-lg border-l-4 border-brand-navy">
          <h3 class="text-xl text-brand-black mb-2">Lions — Ages 7–13</h3>
          <p class="text-brand-gray text-sm leading-relaxed">Real Brazilian Jiu-Jitsu. Progressive belt system, genuine technique, real challenge. By six months in, a Lions student from Millburn can handle themselves physically in a way most adults can't. That's the confidence parents are looking for — earned, not talked about.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Muay Thai + MMA -->
  <section class="section-pad bg-brand-navy text-white">
    <div class="container-page max-w-4xl">
      <div class="grid md:grid-cols-2 gap-8">
        <div>
          <div class="eyebrow text-brand-gold">Muay Thai</div>
          <h2 class="text-2xl md:text-3xl mb-4">Closest Muay Thai to Millburn</h2>
          <p class="text-white/90 leading-relaxed">
            Millburn has no Muay Thai program. The entire Short Hills, Millburn, Livingston corridor has no authentic Muay Thai instruction. AllStar is the closest option. Real Muay Thai — elbows, knees, clinch work, pad rounds — not cardio kickboxing dressed up with a Thai name.
          </p>
        </div>
        <div>
          <div class="eyebrow text-brand-gold">MMA</div>
          <h2 class="text-2xl md:text-3xl mb-4">MMA Near Millburn, NJ</h2>
          <p class="text-white/90 leading-relaxed">
            Our MMA program combines BJJ, Muay Thai, and wrestling under the instruction of Jamal Patterson — professional MMA veteran who has cornered UFC athletes. Adults 16 and up. The most complete martial arts program available to Millburn residents within a reasonable drive.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Landmarks -->
  <section class="section-pad bg-white">
    <div class="container-page max-w-3xl">
      <div class="eyebrow">If you know Millburn</div>
      <h2 class="text-2xl md:text-3xl text-brand-black mb-5">About 15 Minutes West on Route 22</h2>
      <div class="flex flex-wrap gap-2">
        {["Millburn Downtown", "Short Hills Mall", "Millburn High School", "Millburn Middle School", "South Mountain Elementary", "Gero Park", "Taylor Park", "Short Hills Train Station", "Essex County Country Club"].map((l) => (
          <span class="bg-brand-gray-light text-brand-gray px-4 py-2 rounded-full text-sm">📍 {l}</span>
        ))}
      </div>
    </div>
  </section>

  <FAQ items={faqs} />

  <CTA
    headline="Two Weeks Free — Millburn & Short Hills Families Welcome"
    sub="Show up. Bring water. We'll handle the rest. No commitment, no pressure."
  />
</PageLayout>
