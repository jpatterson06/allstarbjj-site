---
// Base layout — <head> meta + header + footer.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'AllStar Martial Arts — Brazilian Jiu Jitsu, Muay Thai, MMA + Kids classes in Union, NJ. Free 2-week trial. Family-owned. Beginner-friendly.',
  ogImage = '/images/adult-bjj-hero.jpg',
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

// Google Analytics 4 Configuration
// Get your GA4 Measurement ID from Google Analytics Console
// Instructions:
// 1. Go to https://analytics.google.com/
// 2. Create a new property for allstarbjj.com
// 3. Get your Measurement ID (looks like: G-XXXXXXXXXX)
// 4. Add it to .env file as: PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
// 5. Build/deploy the site
const ga4MeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;

// Google Tag Manager container for allstarbjj.com.
// Hardcoded on purpose with an env override: an unset variable here would
// silently disable every marketing tag on the site, which is exactly the
// failure that went unnoticed before. Override with PUBLIC_GTM_CONTAINER_ID
// only if the container itself ever changes.
const gtmContainerId = import.meta.env.PUBLIC_GTM_CONTAINER_ID || 'GTM-5NLG8SD';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Favicon links supporting multiple formats -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon-192.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AllStar Martial Arts" />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).toString()} />

    <!-- Roboto + Roboto Condensed (matches current allstarbjj.com) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;900&family=Roboto+Condensed:wght@400;700;900&display=swap" rel="stylesheet" />

    <slot name="head" />

    <!-- Google Tag Manager -->
    {gtmContainerId && (
      <script define:vars={{ gtmContainerId }}>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtmContainerId);
      </script>
    )}
    <!-- End Google Tag Manager -->

    <!-- Google Analytics 4 - gtag.js -->
    {ga4MeasurementId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4MeasurementId}`}></script>
        <script define:vars={{ ga4MeasurementId }}>
          // Initialize Google Analytics 4
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          gtag('js', new Date());
          // config auto-sends page_view with page_location/page_title, so no extra params.
          // NOTE: if the GTM container also has a GA4 Configuration tag for this same
          // Measurement ID, every pageview is counted twice. Keep only one of them.
          gtag('config', ga4MeasurementId);

          // Sitewide conversion click tracking (single delegated capture-phase listener).
          // Never blocks navigation: only fires gtag, wrapped in try/catch.
          document.addEventListener('click', function(e) {
            try {
              if (typeof gtag !== 'function') return;
              var t = e.target;
              if (!t || !t.closest) return;
              var el = t.closest('a, button');
              if (!el) return;
              var href = (el.getAttribute('href') || '').trim();
              var lower = href.toLowerCase();
              var text = (el.textContent || '').replace(/\s+/g, ' ').trim().slice(0, 100);
              var path = window.location.pathname;
              if (lower.indexOf('tel:') === 0) {
                gtag('event', 'click_to_call', { link_url: href, page_path: path });
              } else if (lower.indexOf('sms:') === 0) {
                gtag('event', 'click_to_text', { link_url: href, page_path: path });
              } else if (lower.indexOf('google.com/maps') !== -1 || lower.indexOf('maps.app.goo.gl') !== -1 || lower.indexOf('goo.gl/maps') !== -1) {
                gtag('event', 'click_directions', { link_url: href, page_path: path });
              } else if (
                lower.indexOf('/trial/') === 0 || lower.indexOf('/schedule/') === 0 ||
                /free trial|start your trial/i.test(text)
              ) {
                gtag('event', 'cta_click', { link_text: text, link_url: href, page_path: path });
              }
            } catch (err) { /* analytics must never break the page */ }
          }, true);

          // Track button/link clicks on elements with data-track-event attribute
          // Usage: <button data-track-event="button_name" data-track-label="Button Label">Click me</button>
          document.addEventListener('click', function(e) {
            const el = e.target.closest('[data-track-event]');
            if (el) {
              const eventName = el.getAttribute('data-track-event');
              const eventLabel = el.getAttribute('data-track-label') || el.textContent?.trim() || 'unknown';
              if (eventName && typeof gtag !== 'undefined') {
                gtag('event', eventName, {
                  'event_label': eventLabel,
                  'event_category': 'engagement'
                });
              }
            }
          }, true);

          // Track form submissions on forms with data-track-form attribute
          // Usage: <form data-track-form="contact_form">...</form>
          document.addEventListener('submit', function(e) {
            const form = e.target;
            if (form && form.hasAttribute('data-track-form')) {
              const formName = form.getAttribute('data-track-form');
              if (typeof gtag !== 'undefined') {
                gtag('event', 'form_submit', {
                  'event_label': formName,
                  'event_category': 'engagement'
                });
              }
            }
          }, true);
        </script>
      </>
    )}
    {!ga4MeasurementId && (
      <script>
        console.warn('Google Analytics 4: PUBLIC_GA_MEASUREMENT_ID not configured in .env file. GA4 tracking disabled.');
      </script>
    )}

    <!-- LocalBusiness schema (sitewide) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "MartialArtsSchool",
      "name": "AllStar Martial Arts",
      "url": "https://allstarbjj.com",
      "telephone": "+1-908-341-1131",
      "email": "info@allstarbjj.com",
      "image": "https://allstarbjj.com/images/adult-bjj-hero.jpg",
      "priceRange": "$179-$249 per month",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "1166 West Chestnut St",
        "addressLocality": "Union",
        "addressRegion": "NJ",
        "postalCode": "07083",
        "addressCountry": "US"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 40.6925196,
        "longitude": -74.2863264
      },
      "hasMap": "https://maps.app.goo.gl/cBJKvZMvtEjfTgNY9",
      "openingHoursSpecification": [
        { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"], "opens": "09:00", "closes": "21:00" },
        { "@type": "OpeningHoursSpecification", "dayOfWeek": "Saturday", "opens": "09:00", "closes": "13:00" }
      ],
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.6",
        "reviewCount": "192",
        "bestRating": "5",
        "worstRating": "1"
      },
      "founder": {
        "@type": "Person",
        "name": "Jamal Patterson",
        "jobTitle": "Founder & Head Instructor",
        "description": "4th degree Brazilian Jiu-Jitsu black belt under Renzo Gracie, ADCC veteran, former pro MMA fighter (IFL, Bellator), UWC Light Heavyweight Champion"
      },
      "foundingDate": "2011",
      "knowsAbout": ["Brazilian Jiu-Jitsu", "Muay Thai", "Kickboxing", "Mixed Martial Arts", "Boxing", "Wrestling", "Self-Defense"],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "AllStar Martial Arts Programs",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Brazilian Jiu-Jitsu classes in Union, NJ" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Muay Thai classes in Union, NJ" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Kickboxing classes in Union, NJ" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Mixed Martial Arts (MMA) classes in Union, NJ" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Boxing classes in Union, NJ" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Wrestling classes in Union, NJ" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Self-Defense classes in Union, NJ" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Kids Martial Arts classes in Union, NJ" } }
        ]
      },
      "areaServed": ["Union", "Springfield", "Cranford", "Maplewood", "Millburn", "Mountainside", "Roselle Park", "Westfield"],
      "sameAs": [
        "https://www.facebook.com/allstarbjjmma",
        "https://www.instagram.com/allstar_martialarts"
      ]
    })} />
  </head>

  <body class="bg-white text-brand-black antialiased">
    <!-- Google Tag Manager (noscript) -->
    {gtmContainerId && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${gtmContainerId}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
        ></iframe>
      </noscript>
    )}
    <!-- End Google Tag Manager (noscript) -->
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
